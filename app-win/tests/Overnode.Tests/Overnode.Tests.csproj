<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MVVMTK0045;CS8602</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Overnode.App\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\SessionPersistence.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\AuthService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ServerService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ServerFilesService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ServerConfigService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ServerDeployService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\APIClient.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\QuickActionServerStorage.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\DiscordRPCService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ServerWebSocketManager.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\UpdateService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ExternalEditorManager.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\FileUploadSecurity.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\FolderSyncScanner.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\FolderSyncExecutor.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\FolderSyncManager.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\TrayIconManager.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ConsoleColorHelper.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\EasterEggAssetManager.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ColorHexHelper.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\GodPackService.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Services\ThemeManager.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\ViewModels\TwoFactorViewModel.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\ViewModels\ServerDetailViewModel.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\ViewModels\CreateServerViewModel.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\ViewModels\UpdateViewModel.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Overnode.App\Localization\LocalizationManager.cs" Link="Localization\%(Filename)%(Extension)" />
    <Content Include="..\..\src\Overnode.App\Localization\*.json" Link="Localization\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Overnode.App\Assets\EasterEgg\*.*" Link="Assets\EasterEgg\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
