<UserControl
    x:Class="Overnode.App.Views.Settings.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24" MaxWidth="820" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="SettingsTitle"
                           Text="Paramètres"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                <TextBlock x:Name="SettingsSubtitle"
                           Text="Gérez les préférences de l'application et les paramètres de votre compte."
                           FontSize="13"
                           Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
            </StackPanel>

            <!-- Language Card -->
            <Border Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="LanguageTitle"
                                   Text="Langue de l'application"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        <TextBlock x:Name="LanguageDesc"
                                   Text="Choisissez la langue d'affichage de l'interface Overnode."
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- French Button -->
                        <Button x:Name="BtnLangFr"
                                Click="OnFrenchSelected"
                                Padding="16,10"
                                CornerRadius="8"
                                BorderThickness="1"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🇫🇷" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Français" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- English Button -->
                        <Button x:Name="BtnLangEn"
                                Click="OnEnglishSelected"
                                Padding="16,10"
                                CornerRadius="8"
                                BorderThickness="1"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🇬🇧" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="English" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Account & Session Card -->
            <Border Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="18">
                    <TextBlock x:Name="AccountTitle"
                               Text="Compte &amp; Session"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OvernodeTextPrimaryBrush}" />

                    <!-- User Info Banner -->
                    <Border Background="{StaticResource OvernodeSecondaryCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0"
                                    Width="44" Height="44"
                                    CornerRadius="22"
                                    Background="{StaticResource OvernodeAccentGoldBrush}"
                                    Margin="0,0,14,0">
                                <TextBlock x:Name="UserInitialText"
                                           Text="U"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#000000"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Name & Email -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="UsernameText"
                                               Text="Utilisateur"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                    <Border Background="#26F59E0B"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="UserRoleText"
                                                   Text="Membre"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="UserEmailText"
                                           Text="email@overnode.fr"
                                           FontSize="12"
                                           Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Logout Button -->
                            <Button x:Name="LogoutButton"
                                    Grid.Column="2"
                                    Click="OnLogoutClicked"
                                    Background="#1AF43F5E"
                                    BorderBrush="#33F43F5E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="12" Foreground="#F43F5E" />
                                    <TextBlock x:Name="LogoutButtonText"
                                               Text="Déconnexion"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#F43F5E" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Security Notice -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                        <TextBlock x:Name="SecurityNoticeText"
                                   Text="Session active chiffrée avec la protection matérielle Windows DPAPI."
                                   FontSize="11.5"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- External Editor Card -->
            <Border Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="ExternalEditorTitle"
                                   Text="Éditeur Externe"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        <TextBlock x:Name="ExternalEditorDesc"
                                   Text="Ouvrez et modifiez directement les fichiers serveur depuis votre éditeur de code favori sous Windows."
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Active Editor Application Selector -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ExternalEditorChoiceLabel"
                                       Text="Application d'édition"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="ExternalEditorActivePathText"
                                       Text="Détection automatique..."
                                       FontSize="11"
                                       Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ExternalEditorComboBox"
                                  Grid.Column="1"
                                  MinWidth="240"
                                  SelectionChanged="OnExternalEditorComboBoxSelectionChanged" />
                    </Grid>

                    <Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="AlwaysOpenLabel"
                                       Text="Toujours ouvrir avec un éditeur externe"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="AlwaysOpenDesc"
                                       Text="Ouvre automatiquement les fichiers dans votre éditeur favori lors d'un double-clic."
                                       FontSize="11"
                                       Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ExternalEditorToggle"
                                      HorizontalAlignment="Right"
                                      OnContent=""
                                      OffContent=""
                                      Toggled="OnExternalEditorToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quick Action Server Selection Card -->
            <Border Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1AF59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{StaticResource OvernodeAccentGoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="QuickActionTitle"
                                       Text="Action Rapide (Quick Action)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="QuickActionDesc"
                                       Text="Choisissez le serveur Overnode contrôlable directement depuis les raccourcis d'actions rapides."
                                       FontSize="12"
                                       Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource OvernodeBorderSubtleBrush}" />

                    <!-- Server Selection Row -->
                    <Grid>
                        <TextBlock x:Name="QuickActionSelectLabel"
                                   Text="Serveur sélectionné"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <ComboBox x:Name="QuickActionServerCombo"
                                  HorizontalAlignment="Right"
                                  MinWidth="240"
                                  SelectionChanged="OnQuickActionServerChanged" />
                    </Grid>

                    <!-- Server Status Preview -->
                    <Border x:Name="QuickActionStatusCard"
                            Visibility="Collapsed"
                            Background="{StaticResource OvernodeSecondaryCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="QuickActionStatusDot" Width="8" Height="8" Fill="#40C780" VerticalAlignment="Center" />
                                <TextBlock x:Name="QuickActionStatusText" Text="Statut : En ligne" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="•" Foreground="{StaticResource OvernodeTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="QuickActionRamText" Text="RAM : 1024 MB" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="•" Foreground="{StaticResource OvernodeTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="QuickActionCpuText" Text="CPU : 100%" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Software Updates Card -->
            <Border Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="UpdatesTitle"
                                       Text="Mises à jour du logiciel"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="AppVersionText"
                                       Text="Version installée : v1.0.0 (Windows Native x64)"
                                       FontSize="12"
                                       Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>

                        <Button x:Name="CheckUpdatesBtn"
                                HorizontalAlignment="Right"
                                Background="{StaticResource OvernodeAccentGoldBrush}"
                                Foreground="#000000"
                                FontWeight="SemiBold"
                                FontSize="12"
                                CornerRadius="6"
                                Padding="14,8"
                                BorderThickness="0"
                                Click="OnCheckUpdatesClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="CheckUpdatesBtnText" Text="Rechercher des mises à jour" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                        <TextBlock x:Name="UpToDateText"
                                   Text="Votre application est à jour."
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
