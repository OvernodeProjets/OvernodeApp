<UserControl
    x:Class="Overnode.App.Views.Settings.GodPackThemeSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="CardRootBorder"
            Background="{StaticResource OvernodeCardBrush}"
            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">
        <StackPanel Spacing="18">
            <!-- Header: Title and Status Badge -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Crown Icon -->
                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="8"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0.0" />
                            <GradientStop Color="#D97706" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE735;" FontSize="18" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="CardTitleText"
                               Text="Personnalisation Overnode"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    <TextBlock x:Name="CardSubtitleText"
                               Text="Fonctionnalités exclusives pour les possesseurs du Pack God"
                               FontSize="12"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>

                <!-- Locked / Active Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Locked Badge -->
                    <Border x:Name="LockedBadge"
                            Background="#1AF59E0B"
                            BorderBrush="#4DF59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            <TextBlock x:Name="LockedBadgeText"
                                       Text="Pack God Requis"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="{StaticResource OvernodeBorderSubtleBrush}" />

            <!-- Feedback Alerts -->
            <Border x:Name="SuccessAlertBanner"
                    Visibility="Collapsed"
                    Background="#2622C55E"
                    BorderBrush="#4D22C55E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                        <TextBlock x:Name="SuccessAlertText" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4" Click="OnDismissAlertClicked">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="ErrorAlertBanner"
                    Visibility="Collapsed"
                    Background="#26EF4444"
                    BorderBrush="#4DEF4444"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                        <TextBlock x:Name="ErrorAlertText" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4" Click="OnDismissAlertClicked">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 1. LOCKED VIEW -->
            <StackPanel x:Name="LockedPanel" Spacing="16">
                <Border Background="{StaticResource OvernodeSecondaryCardBrush}"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE735;"
                                  FontSize="28"
                                  Foreground="{StaticResource OvernodeAccentGoldBrush}"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="LockedTitleText"
                                       Text="Débloquez la personnalisation totale de votre application"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="LockedDescText"
                                       Text="Avec le Pack God sur Toledo, vous pouvez personnaliser Overnode à 100% : installer des thèmes préconçus de la communauté, ajuster toutes les couleurs, incruster une image de fond personnalisée avec flou réglable, choisir votre page d'accueil par défaut, déplacer la disposition de l'interface et exporter votre configuration dans un fichier config.overnode.app partageable avec vos proches."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Locked Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="DiscoverStoreBtn"
                            Background="{StaticResource OvernodeAccentGoldBrush}"
                            Foreground="#000000"
                            FontWeight="SemiBold"
                            FontSize="12"
                            CornerRadius="6"
                            Padding="14,8"
                            BorderThickness="0"
                            Click="OnDiscoverStoreClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BF;" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="DiscoverStoreBtnText" Text="Découvrir le Pack God dans la Boutique" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CheckSubBtn"
                            Background="Transparent"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,8"
                            Click="OnCheckSubscriptionClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="CheckSubProgress" Width="14" Height="14" Visibility="Collapsed" />
                            <FontIcon x:Name="CheckSubIcon" Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="CheckSubBtnText" Text="Vérifier mon abonnement" FontSize="12" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ActivateDiscordVIPBtn"
                            Background="Transparent"
                            BorderBrush="{StaticResource OvernodeAccentDiscordBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,8"
                            Click="OnActivateDiscordVIPClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="11" Foreground="{StaticResource OvernodeAccentDiscordBrush}" />
                            <TextBlock x:Name="ActivateDiscordVIPBtnText" Text="Discord VIP (Ctrl+D)" FontSize="12" Foreground="{StaticResource OvernodeAccentDiscordBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 2. UNLOCKED CUSTOMIZER VIEW -->
            <StackPanel x:Name="UnlockedPanel" Visibility="Collapsed" Spacing="18">
                <!-- Sub-tabs bar -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TabBtnPresets" Click="OnSubTabClicked" Tag="presets" CornerRadius="6" Padding="12,7" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE790;" FontSize="11" />
                                <TextBlock x:Name="TabLabelPresets" Text="Thèmes Préconçus" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtnColors" Click="OnSubTabClicked" Tag="colors" CornerRadius="6" Padding="12,7" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7E6;" FontSize="11" />
                                <TextBlock x:Name="TabLabelColors" Text="Couleurs" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtnBackground" Click="OnSubTabClicked" Tag="background" CornerRadius="6" Padding="12,7" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEB9F;" FontSize="11" />
                                <TextBlock x:Name="TabLabelBackground" Text="Arrière-plan &amp; Incrustation" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtnLayout" Click="OnSubTabClicked" Tag="layout" CornerRadius="6" Padding="12,7" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE728;" FontSize="11" />
                                <TextBlock x:Name="TabLabelLayout" Text="Disposition &amp; Navigation" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtnShare" Click="OnSubTabClicked" Tag="share" CornerRadius="6" Padding="12,7" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72D;" FontSize="11" />
                                <TextBlock x:Name="TabLabelShare" Text="Import / Export" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- SUB-TAB 1: Presets -->
                <StackPanel x:Name="SubTabPresetsContent" Spacing="16">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="PresetsDescText"
                                       Text="Choisissez un thème conçu par nous et la communauté :"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock Text="Sélectionnez un style pour appliquer harmonieusement l'ensemble de la palette visuelle."
                                       FontSize="11.5"
                                       Foreground="{StaticResource OvernodeTextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Responsive 3-column / 2-column Presets Grid -->
                    <Grid x:Name="PresetsGrid" ColumnSpacing="14" RowSpacing="14" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>

                <!-- SUB-TAB 2: Custom Colors -->
                <StackPanel x:Name="SubTabColorsContent" Visibility="Collapsed" Spacing="16">
                    <TextBlock x:Name="ColorsDescText"
                               Text="Personnalisez la palette de couleurs de l'application :"
                               FontSize="12.5"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}" />

                    <!-- Grid of color picker cards (2 columns) -->
                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Accent Gold, Background -->
                        <Border Grid.Row="0" Grid.Column="0" x:Name="ColorCardAccentGold" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />
                        <Border Grid.Row="0" Grid.Column="1" x:Name="ColorCardBackground" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />

                        <!-- Row 1: Card Bg, Secondary Card Bg -->
                        <Border Grid.Row="1" Grid.Column="0" x:Name="ColorCardCardBg" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />
                        <Border Grid.Row="1" Grid.Column="1" x:Name="ColorCardSecCardBg" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />

                        <!-- Row 2: Text Primary, Text Secondary -->
                        <Border Grid.Row="2" Grid.Column="0" x:Name="ColorCardTextPrimary" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />
                        <Border Grid.Row="2" Grid.Column="1" x:Name="ColorCardTextSecondary" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />

                        <!-- Row 3: Border, Accent Cyan -->
                        <Border Grid.Row="3" Grid.Column="0" x:Name="ColorCardBorder" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />
                        <Border Grid.Row="3" Grid.Column="1" x:Name="ColorCardAccentCyan" Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" />
                    </Grid>
                </StackPanel>

                <!-- SUB-TAB 3: Background -->
                <StackPanel x:Name="SubTabBackgroundContent" Visibility="Collapsed" Spacing="16">
                    <TextBlock x:Name="BgDescText"
                               Text="Incrustation d'un arrière-plan personnalisé :"
                               FontSize="12.5"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}" />

                    <!-- Web URL input -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="BgUrlLabelText" Text="Lien de l'image (URL Web) :" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="BgUrlInput" Grid.Column="0" PlaceholderText="https://images.unsplash.com/photo-..." FontSize="12.5" />

                            <Button x:Name="BgApplyUrlBtn"
                                    Grid.Column="1"
                                    Background="{StaticResource OvernodeAccentGoldBrush}"
                                    Foreground="#000000"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    CornerRadius="6"
                                    Padding="14,8"
                                    Click="OnApplyBgUrlClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing x:Name="BgDownloadRing" Width="12" Height="12" Visibility="Collapsed" Foreground="#000000" />
                                    <TextBlock x:Name="BgApplyBtnText" Text="Appliquer" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BgClearBtn"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource OvernodeAccentDangerBrush}"
                                    FontSize="12"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Click="OnClearBgClicked">
                                <TextBlock x:Name="BgClearBtnText" Text="Effacer" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Choose Local File -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BgChooseFileBtn"
                                Background="Transparent"
                                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Click="OnChooseLocalBgFileClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                <TextBlock x:Name="BgChooseFileBtnText" Text="Choisir une image sur mon PC..." FontSize="12" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="BgLocalPathPreviewText"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{StaticResource OvernodeTextMutedBrush}" />
                    </StackPanel>

                    <!-- Active Preview Card -->
                    <Border x:Name="BgPreviewCard"
                            Visibility="Collapsed"
                            Background="{StaticResource OvernodeSecondaryCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="80" Height="50" CornerRadius="6" BorderBrush="{StaticResource OvernodeAccentGoldBrush}" BorderThickness="1" Margin="0,0,14,0">
                                <Image x:Name="BgThumbnailImage" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                                    <TextBlock x:Name="BgActivePreviewLabel" Text="Arrière-plan actif" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="BgResolutionText" Text="Image active" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Rectangle Height="1" Fill="{StaticResource OvernodeBorderSubtleBrush}" />

                    <!-- Sliders: Opacity, Blur, Darkness -->
                    <StackPanel Spacing="16">
                        <!-- Opacity -->
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock x:Name="BgOpacityLabelText" Text="Opacité de l'incrustation" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                <TextBlock x:Name="BgOpacityValueText" Text="85%" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            </Grid>
                            <Slider x:Name="BgOpacitySlider" Minimum="5" Maximum="100" StepFrequency="5" ValueChanged="OnBgOpacitySliderChanged" />
                        </StackPanel>

                        <!-- Blur -->
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock x:Name="BgBlurLabelText" Text="Flou d'arrière-plan (Blur)" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                <TextBlock x:Name="BgBlurValueText" Text="0 px" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            </Grid>
                            <Slider x:Name="BgBlurSlider" Minimum="0" Maximum="30" StepFrequency="1" ValueChanged="OnBgBlurSliderChanged" />
                        </StackPanel>

                        <!-- Darkness -->
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock x:Name="BgDarknessLabelText" Text="Masque sombre de contraste" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                <TextBlock x:Name="BgDarknessValueText" Text="30%" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            </Grid>
                            <Slider x:Name="BgDarknessSlider" Minimum="0" Maximum="90" StepFrequency="5" ValueChanged="OnBgDarknessSliderChanged" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- SUB-TAB 4: Layout -->
                <StackPanel x:Name="SubTabLayoutContent" Visibility="Collapsed" Spacing="16">
                    <TextBlock x:Name="LayoutDescText"
                               Text="Disposition &amp; Préférences de Navigation :"
                               FontSize="12.5"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}" />

                    <!-- Landing Tab Picker -->
                    <Border Background="{StaticResource OvernodeSecondaryCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LandingTabLabelText" Text="Page d'arrivée au lancement d'Overnode :" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <ComboBox x:Name="LandingTabComboBox" MinWidth="280" SelectionChanged="OnLandingTabSelectionChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Sidebar Position -->
                    <Border Background="{StaticResource OvernodeSecondaryCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SidebarPosLabelText" Text="Position de la barre latérale (Sidebar) :" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="SidebarLeftBtn" Click="OnSidebarLeftClicked" CornerRadius="6" Padding="14,8" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE700;" FontSize="12" />
                                        <TextBlock x:Name="SidebarLeftText" Text="Gauche (Défaut)" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SidebarRightBtn" Click="OnSidebarRightClicked" CornerRadius="6" Padding="14,8" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE700;" FontSize="12" />
                                        <TextBlock x:Name="SidebarRightText" Text="Droite (Inversée)" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card Corner Radius -->
                    <Border Background="{StaticResource OvernodeSecondaryCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock x:Name="CardRadiusLabelText" Text="Rayon de courbure des cartes :" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                <TextBlock x:Name="CardRadiusValueText" Text="10 px" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            </Grid>
                            <Slider x:Name="CardRadiusSlider" Minimum="4" Maximum="20" StepFrequency="2" ValueChanged="OnCardRadiusSliderChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SUB-TAB 5: Share -->
                <StackPanel x:Name="SubTabShareContent" Visibility="Collapsed" Spacing="16">
                    <TextBlock x:Name="ShareDescText"
                               Text="Exportez votre thème pour vos amis ou importez une création :"
                               FontSize="12.5"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}" />

                    <Border Background="{StaticResource OvernodeSecondaryCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <!-- Export -->
                                <Button x:Name="ExportConfigBtn"
                                        Background="{StaticResource OvernodeAccentGoldBrush}"
                                        Foreground="#000000"
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        CornerRadius="6"
                                        Padding="14,8"
                                        BorderThickness="0"
                                        Click="OnExportConfigClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="12" FontWeight="Bold" />
                                        <TextBlock x:Name="ExportConfigBtnText" Text="Extraire ma configuration (config.overnode.app)" />
                                    </StackPanel>
                                </Button>

                                <!-- Import -->
                                <Button x:Name="ImportConfigBtn"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                        BorderThickness="1"
                                        FontSize="12"
                                        CornerRadius="6"
                                        Padding="14,8"
                                        Click="OnImportConfigClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                        <TextBlock x:Name="ImportConfigBtnText" Text="Importer une configuration..." Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Reset -->
                            <Button x:Name="ResetConfigBtn"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,8"
                                    Click="OnResetConfigClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="11" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                                    <TextBlock x:Name="ResetConfigBtnText" Text="Réinitialiser" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
