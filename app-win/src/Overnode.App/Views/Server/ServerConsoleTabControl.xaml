<UserControl
    x:Class="Overnode.App.Views.Server.ServerConsoleTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <!-- Live Resource Chips Bar -->
        <StackPanel Orientation="Horizontal" Spacing="16">
            <!-- CPU Chip -->
            <Border Background="#201F232B"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="#33BFE0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="ResourceCpuLabel" Text="PROCESSEUR (CPU)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        <TextBlock x:Name="CpuText" Text="0.0% / 100%" FontSize="12" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Memory Chip -->
            <Border Background="#201F232B"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE958;" FontSize="16" Foreground="#598CF2" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="ResourceRamLabel" Text="MÉMOIRE (RAM)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        <TextBlock x:Name="RamText" Text="0 / 1024 MB" FontSize="12" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Disk Chip -->
            <Border Background="#201F232B"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="#40C780" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="ResourceDiskLabel" Text="ESPACE DISQUE (SSD)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        <TextBlock x:Name="DiskText" Text="0 / 5120 MB" FontSize="12" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Terminal Window Container -->
        <Border Background="#0C0E14"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="360" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Terminal Header Bar -->
                <Border Grid.Row="0"
                        Background="#141720"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8"
                        CornerRadius="8,8,0,0">
                    <Grid>
                        <!-- 3 macOS-style terminal dots -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#EF4444" />
                            <Ellipse Width="10" Height="10" Fill="#F59E0B" />
                            <Ellipse Width="10" Height="10" Fill="#10B981" />
                        </StackPanel>

                        <!-- Centered Title -->
                        <TextBlock Text="terminal - bash"
                                   FontSize="11"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="#55FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- Right Actions -->
                        <Button Click="OnClearConsoleClicked"
                                HorizontalAlignment="Right"
                                Padding="8,3"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                                <TextBlock x:Name="ClearText" Text="Effacer" FontSize="11" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Scrollable Console Output -->
                <ScrollViewer x:Name="ConsoleScrollViewer"
                              Grid.Row="1"
                              Padding="14,12"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <RichTextBlock x:Name="ConsoleRichTextBlock"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                   FontSize="12"
                                   Foreground="#CBD5E1"
                                   KeyDown="OnConsoleKeyDown">
                        <RichTextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Copier" Click="OnContextMenuCopyClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Tout sélectionner" Click="OnContextMenuSelectAllClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Effacer" Click="OnClearConsoleClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </RichTextBlock.ContextFlyout>
                    </RichTextBlock>
                </ScrollViewer>

                <!-- Command Input Bar -->
                <Border Grid.Row="2"
                        Background="#141720"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8"
                        CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Prompt Symbol -->
                        <TextBlock Grid.Column="0"
                                   Text="$"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="{StaticResource OvernodeAccentGoldBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <!-- Input TextBox -->
                        <TextBox x:Name="CommandTextBox"
                                 Grid.Column="1"
                                 PlaceholderText="Entrez une commande pour le serveur..."
                                 KeyDown="OnCommandKeyDown"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontFamily="Consolas, Segoe UI"
                                 FontSize="13"
                                 VerticalAlignment="Center" />

                        <!-- Send Button -->
                        <Button Grid.Column="2"
                                Click="OnSendCommandClicked"
                                Background="{StaticResource OvernodeAccentGoldBrush}"
                                Foreground="Black"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Padding="14,6"
                                CornerRadius="6"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SendText" Text="Envoyer" />
                                <FontIcon Glyph="&#xE751;" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
