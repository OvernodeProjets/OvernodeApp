<UserControl
    x:Class="Overnode.App.Views.Server.ServerSubusersTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="SubusersTitle" Text="Sous-utilisateurs" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                <TextBlock x:Name="SubusersSubtitle"
                           Text="Partagez l'accès et déléguez la gestion de votre serveur en toute sécurité"
                           FontSize="12"
                           Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Background="{StaticResource OvernodeAccentGoldBrush}"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Padding="14,7"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <Button.Flyout>
                    <Flyout x:Name="InviteSubuserFlyout">
                        <StackPanel Width="280" Spacing="12" Padding="4">
                            <TextBlock x:Name="InviteDialogTitle" Text="Inviter un collaborateur" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                            <TextBox x:Name="SubuserEmailBox" PlaceholderText="adresse@email.com..." />
                            <Button Click="OnInviteSubuserConfirmed"
                                    Background="{StaticResource OvernodeAccentGoldBrush}"
                                    Foreground="Black"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch">
                                <TextBlock x:Name="InviteBtnText" Text="Envoyer l'invitation" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE779;" FontSize="11" />
                    <TextBlock x:Name="InviteSubuserBtnText" Text="Inviter un utilisateur" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty State -->
        <Border x:Name="EmptyContainer"
                Visibility="Collapsed"
                Height="180"
                Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE716;" FontSize="32" Foreground="{StaticResource OvernodeTextMutedBrush}" />
                <TextBlock x:Name="EmptyText" Text="Aucun sous-utilisateur pour ce serveur" FontSize="13" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Subusers List -->
        <ItemsControl x:Name="SubusersItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource OvernodeCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1A598CF2" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="#598CF2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding Email}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OvernodeTextPrimaryBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="#1A40C780" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xEA18;" FontSize="10" Foreground="#40C780" />
                                            <TextBlock Text="{Binding TwoFactorStatusText}" FontSize="10" Foreground="#40C780" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding PermissionsSummary}"
                                               FontSize="11"
                                               Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Delete button -->
                            <Button Grid.Column="2"
                                    Click="OnDeleteSubuserClicked"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8"
                                    CornerRadius="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
