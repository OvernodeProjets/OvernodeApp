<UserControl
    x:Class="Overnode.App.Views.Server.ServerSubdomainsTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="SubdomainsTitle" Text="Sous-domaines" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                <TextBlock x:Name="SubdomainsSubtitle"
                           Text="Connectez votre serveur avec une adresse DNS personnalisée et gratuite"
                           FontSize="12"
                           Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Background="{StaticResource OvernodeAccentGoldBrush}"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Padding="14,7"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <Button.Flyout>
                    <Flyout x:Name="CreateSubdomainFlyout">
                        <StackPanel Width="280" Spacing="12" Padding="4">
                            <TextBlock x:Name="DialogTitle" Text="Créer un sous-domaine" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                            <TextBox x:Name="SubdomainPrefixBox" PlaceholderText="ex : play, mc, lobby..." />
                            <ComboBox x:Name="DomainsComboBox" HorizontalAlignment="Stretch" />
                            <Button Click="OnCreateSubdomainConfirmed"
                                    Background="{StaticResource OvernodeAccentGoldBrush}"
                                    Foreground="Black"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch">
                                <TextBlock x:Name="CreateBtnText" Text="Créer le sous-domaine" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                    <TextBlock x:Name="CreateSubdomainBtnText" Text="Créer un sous-domaine" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty State -->
        <Border x:Name="EmptyContainer"
                Visibility="Collapsed"
                Height="180"
                Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE839;" FontSize="32" Foreground="{StaticResource OvernodeTextMutedBrush}" />
                <TextBlock x:Name="EmptyText" Text="Aucun sous-domaine configuré" FontSize="13" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Subdomains List -->
        <ItemsControl x:Name="SubdomainsItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource OvernodeCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1A33BFE0" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE71B;" FontSize="15" Foreground="#33BFE0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Fqdn}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                <TextBlock Text="Actif (Cloudflare DNS)" FontSize="10" Foreground="#40C780" />
                            </StackPanel>

                            <!-- Copy button -->
                            <Button Grid.Column="2"
                                    Click="OnCopySubdomainClicked"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8"
                                    CornerRadius="6"
                                    Margin="0,0,8,0">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </Button>

                            <!-- Delete button -->
                            <Button Grid.Column="3"
                                    Click="OnDeleteSubdomainClicked"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8"
                                    CornerRadius="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
