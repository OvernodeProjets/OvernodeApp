<UserControl
    x:Class="Overnode.App.Views.Server.ServerPackageTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <!-- Header Card -->
        <Border Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        <TextBlock x:Name="PackageTitleText" Text="Offre &amp; Allocation des Ressources" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="PackageSubtitleText"
                               Text="Ajustez les ressources matérielles allouées à ce serveur dans la limite de votre quota global."
                               FontSize="12"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Click="OnSetMaxClicked"
                        Background="#201F232B"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="12,8"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE740;" FontSize="11" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        <TextBlock x:Name="SetMaxButtonText" Text="Maximum disponible" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Sliders Card -->
        <Border Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
            <StackPanel Spacing="20">
                <!-- RAM Slider Row -->
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="#598CF2" />
                            <TextBlock x:Name="RamLabelText" Text="Mémoire RAM" FontSize="14" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="RamValueText" Text="1024 MB" FontSize="14" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextPrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="RamSlider"
                            Minimum="512"
                            Maximum="4096"
                            StepFrequency="128"
                            ValueChanged="OnRamSliderChanged" />
                </StackPanel>

                <Rectangle Height="1" Fill="{StaticResource OvernodeBorderSubtleBrush}" />

                <!-- CPU Slider Row -->
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="#38BDF8" />
                            <TextBlock x:Name="CpuLabelText" Text="Processeur CPU" FontSize="14" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="CpuValueText" Text="100 %" FontSize="14" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextPrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="CpuSlider"
                            Minimum="50"
                            Maximum="200"
                            StepFrequency="5"
                            ValueChanged="OnCpuSliderChanged" />
                </StackPanel>

                <Rectangle Height="1" Fill="{StaticResource OvernodeBorderSubtleBrush}" />

                <!-- Disk Slider Row -->
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="#40C780" />
                            <TextBlock x:Name="DiskLabelText" Text="Espace Disque" FontSize="14" FontWeight="Medium" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DiskValueText" Text="2048 MB" FontSize="14" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextPrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="DiskSlider"
                            Minimum="1024"
                            Maximum="10240"
                            StepFrequency="512"
                            ValueChanged="OnDiskSliderChanged" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Save Action Row -->
        <Border Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Feedback Banners -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                        <Border x:Name="PackageSuccessBanner"
                                Visibility="Collapsed"
                                Background="#1A10B981"
                                BorderBrush="#4D10B981"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#10B981" />
                                <TextBlock x:Name="PackageSuccessText" Text="Ressources enregistrées avec succès" FontSize="12" Foreground="#10B981" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PackageErrorBanner"
                                Visibility="Collapsed"
                                Background="#1AEF4444"
                                BorderBrush="#4DEF4444"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="#EF4444" />
                                <TextBlock x:Name="PackageErrorText" Text="Erreur lors de la mise à jour des ressources" FontSize="12" Foreground="#EF4444" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button x:Name="SavePackageButton"
                            Grid.Column="1"
                            Click="OnSavePackageClicked"
                            Background="{StaticResource OvernodeAccentGoldBrush}"
                            Foreground="Black"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Padding="18,8"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="PackageProgressRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <FontIcon x:Name="PackageSaveIcon" Glyph="&#xE74E;" FontSize="12" />
                            <TextBlock x:Name="SaveButtonText" Text="Enregistrer les modifications" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
