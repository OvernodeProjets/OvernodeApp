<UserControl
    x:Class="Overnode.App.Views.Server.ServerPluginsTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Overnode.App.Models"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <!-- Top SubTab Selector & Refresh -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Segmented Buttons -->
            <Border Grid.Column="0"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="TabInstalledBtn"
                            Click="OnTabInstalledClicked"
                            Padding="16,6"
                            CornerRadius="6"
                            Background="#20FFFFFF"
                            BorderThickness="0">
                        <TextBlock x:Name="TabInstalledText" Text="Installés" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                    </Button>
                    <Button x:Name="TabSearchBtn"
                            Click="OnTabSearchClicked"
                            Padding="16,6"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                        <TextBlock x:Name="TabSearchText" Text="Recherche &amp; Découverte" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Click="OnRefreshClicked"
                    Background="#201F232B"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    Padding="8"
                    CornerRadius="6">
                <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
            </Button>
        </Grid>

        <!-- Feedback Banners -->
        <Border x:Name="PluginSuccessBanner"
                Visibility="Collapsed"
                Background="#1A10B981"
                BorderBrush="#4D10B981"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#10B981" />
                <TextBlock x:Name="PluginSuccessText" Text="" FontSize="12" Foreground="#10B981" />
            </StackPanel>
        </Border>

        <Border x:Name="PluginErrorBanner"
                Visibility="Collapsed"
                Background="#1AEF4444"
                BorderBrush="#4DEF4444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="#EF4444" />
                <TextBlock x:Name="PluginErrorText" Text="" FontSize="12" Foreground="#EF4444" />
            </StackPanel>
        </Border>

        <!-- Installed Plugins View -->
        <StackPanel x:Name="InstalledSection" Spacing="12">
            <!-- Loading -->
            <ProgressRing x:Name="InstalledProgressRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40" />

            <!-- Empty State -->
            <Border x:Name="InstalledEmptyState"
                    Visibility="Collapsed"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    MinHeight="180">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE74C;" FontSize="32" Foreground="{StaticResource OvernodeTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="NoneInstalledText"
                               Text="Aucun plugin installé détecté"
                               FontSize="13"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- List of Installed Plugins -->
            <ItemsControl x:Name="InstalledItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerPluginItem">
                        <Border Background="{StaticResource OvernodeCardBrush}"
                                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1AF59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74C;" FontSize="16" Foreground="{StaticResource OvernodeAccentGoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                        <Border Background="#1A598CF2" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Platform}" FontSize="10" FontWeight="SemiBold" Foreground="#598CF2" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}" FontSize="11.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Click="OnUninstallPluginClicked"
                                        Tag="{x:Bind}"
                                        Background="#1AEF4444"
                                        BorderBrush="#33EF4444"
                                        BorderThickness="1"
                                        Padding="12,6"
                                        CornerRadius="6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#EF4444" />
                                        <TextBlock Text="{x:Bind UninstallActionText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#EF4444" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Search & Discover View -->
        <StackPanel x:Name="SearchSection" Visibility="Collapsed" Spacing="14">
            <!-- Search Input Bar -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         PlaceholderText="Rechercher des plugins (ex: Essentials, WorldEdit)..."
                         KeyDown="OnSearchBoxKeyDown" />

                <Button Grid.Column="1"
                        Click="OnSearchSubmitClicked"
                        Background="{StaticResource OvernodeAccentGoldBrush}"
                        Foreground="Black"
                        FontWeight="SemiBold"
                        Padding="16,8"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="11" />
                        <TextBlock x:Name="SearchButtonText" Text="Rechercher" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Loading Ring -->
            <ProgressRing x:Name="SearchProgressRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,30" />

            <!-- Empty Search Results -->
            <Border x:Name="SearchEmptyState"
                    Visibility="Collapsed"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    MinHeight="160">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{StaticResource OvernodeTextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="NoSearchResultsText"
                               Text="Aucun résultat trouvé pour cette recherche"
                               FontSize="13"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Search Results Items -->
            <ItemsControl x:Name="SearchItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerPluginItem">
                        <Border Background="{StaticResource OvernodeCardBrush}"
                                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#14FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74C;" FontSize="16" Foreground="{StaticResource OvernodeTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                        <Border Background="#1AF59E0B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Platform}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}" FontSize="11.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Click="OnInstallPluginClicked"
                                        Tag="{x:Bind}"
                                        Background="{StaticResource OvernodeAccentGoldBrush}"
                                        Foreground="Black"
                                        FontWeight="SemiBold"
                                        Padding="14,6"
                                        CornerRadius="6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="11" />
                                        <TextBlock Text="{x:Bind InstallActionText}" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
