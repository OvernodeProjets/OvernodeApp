<UserControl
    x:Class="Overnode.App.Views.Server.ServerLogsTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Overnode.App.Models"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <!-- Header Card -->
        <Border Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        <TextBlock x:Name="LogsTitleText" Text="Journaux d'Activité" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="LogsSubtitleText"
                               Text="Historique des actions d'administration effectuées sur ce serveur."
                               FontSize="12"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Click="OnRefreshClicked"
                        Background="#201F232B"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="8"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Loading Ring -->
        <ProgressRing x:Name="LogsProgressRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40" />

        <!-- Empty State -->
        <Border x:Name="LogsEmptyState"
                Visibility="Collapsed"
                Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24"
                MinHeight="180">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE9D9;" FontSize="32" Foreground="{StaticResource OvernodeTextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="LogsEmptyText"
                           Text="Aucun journal d'activité enregistré pour le moment."
                           FontSize="13"
                           Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Logs Items List -->
        <ItemsControl x:Name="LogsItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ServerActivityLog">
                    <Border Background="{StaticResource OvernodeCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#14FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#598CF2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Action}" FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="par" FontSize="11" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Username}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Timestamp}"
                                       FontFamily="Consolas, Segoe UI"
                                       FontSize="11.5"
                                       Foreground="{StaticResource OvernodeTextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
