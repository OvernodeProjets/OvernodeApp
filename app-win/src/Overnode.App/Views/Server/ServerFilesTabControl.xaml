<UserControl
    x:Class="Overnode.App.Views.Server.ServerFilesTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Normal Files Browser View -->
        <StackPanel x:Name="FileBrowserContainer" Spacing="14">
            <!-- Breadcrumbs & Actions Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Parent Dir Button -->
                    <Button x:Name="ParentDirBtn"
                            Click="OnParentDirClicked"
                            Visibility="Collapsed"
                            Background="#201F232B"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="10,6"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="11" />
                            <TextBlock x:Name="ParentDirText" Text="Dossier parent" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Path Display -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        <TextBlock x:Name="CurrentDirText"
                                   Text="/"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons: Refresh, New Folder -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnRefreshFilesClicked"
                            Background="#201F232B"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="8"
                            CornerRadius="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </Button>

                    <Button x:Name="NewFolderBtn"
                            Background="{StaticResource OvernodeCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="12,6"
                            CornerRadius="6">
                        <Button.Flyout>
                            <Flyout x:Name="NewFolderFlyout">
                                <StackPanel Width="240" Spacing="10" Padding="4">
                                    <TextBlock x:Name="NewFolderDialogTitle" Text="Nouveau dossier" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="NewFolderNameBox" PlaceholderText="Nom du dossier..." />
                                    <Button Click="OnCreateFolderConfirmed"
                                            Background="{StaticResource OvernodeAccentGoldBrush}"
                                            Foreground="Black"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="CreateFolderBtnText" Text="Créer" HorizontalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="12" Foreground="White" />
                            <TextBlock x:Name="NewFolderText" Text="Nouveau dossier" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Feedback Banners -->
            <Border x:Name="FileSuccessBanner"
                    Visibility="Collapsed"
                    Background="#1A10B981"
                    BorderBrush="#4D10B981"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#10B981" />
                    <TextBlock x:Name="FileSuccessText" Text="" FontSize="12" Foreground="#10B981" />
                </StackPanel>
            </Border>

            <Border x:Name="FileErrorBanner"
                    Visibility="Collapsed"
                    Background="#1AEF4444"
                    BorderBrush="#4DEF4444"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="#EF4444" />
                    <TextBlock x:Name="FileErrorText" Text="" FontSize="12" Foreground="#EF4444" />
                </StackPanel>
            </Border>

            <!-- Loading State -->
            <Border x:Name="FilesLoadingContainer"
                    Visibility="Collapsed"
                    Height="240"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <ProgressRing IsActive="True" Width="28" Height="28" />
                    <TextBlock x:Name="FilesLoadingText" Text="Chargement des fichiers..." FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <Border x:Name="FilesEmptyContainer"
                    Visibility="Collapsed"
                    Height="240"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{StaticResource OvernodeTextMutedBrush}" />
                    <TextBlock x:Name="FilesEmptyText" Text="Ce dossier est vide" FontSize="13" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Files List -->
            <Border x:Name="FilesListContainer"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <ItemsControl x:Name="FilesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnFileRowClicked"
                                    DoubleTapped="OnFileRowDoubleTapped"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="12,9"
                                    Margin="0,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Ouvrir / Éditer" Click="OnContextMenuOpenClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Ouvrir avec l'éditeur externe" Click="OnContextMenuOpenExternalClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Supprimer" Click="OnContextMenuDeleteClicked" Foreground="{StaticResource OvernodeAccentDangerBrush}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <FontIcon Grid.Column="0"
                                              Glyph="{Binding IconGlyph}"
                                              FontSize="15"
                                              Foreground="{StaticResource OvernodeAccentGoldBrush}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center" />

                                    <!-- Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Size -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedSize}"
                                               FontSize="11"
                                               FontFamily="Consolas, Segoe UI"
                                               Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,16,0" />

                                    <!-- Chevron or dots -->
                                    <FontIcon Grid.Column="3"
                                              Glyph="&#xE76C;"
                                              FontSize="10"
                                              Foreground="{StaticResource OvernodeTextMutedBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- Built-in File Editor Overlay -->
        <Border x:Name="FileEditorContainer"
                Visibility="Collapsed"
                Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="420" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Editor Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        <TextBlock x:Name="EditingFileNameText"
                                   Text="filename.txt"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   FontFamily="Consolas, Segoe UI" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnCancelEditClicked"
                                Background="Transparent"
                                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="12,6"
                                CornerRadius="6">
                            <TextBlock x:Name="CancelEditText" Text="Fermer" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </Button>

                        <Button Click="OnSaveFileClicked"
                                Background="{StaticResource OvernodeAccentGoldBrush}"
                                Foreground="Black"
                                FontWeight="SemiBold"
                                Padding="16,6"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="11" />
                                <TextBlock x:Name="SaveFileText" Text="Enregistrer" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Editor Text Box -->
                <TextBox x:Name="FileEditorTextBox"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         Background="#0C0E14"
                         Foreground="#CBD5E1"
                         BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                         BorderThickness="1"
                         CornerRadius="6"
                         Padding="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <!-- Editor Footer -->
                <TextBlock Grid.Row="2"
                           x:Name="EditorSaveStatusText"
                           Text=""
                           FontSize="11"
                           Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
