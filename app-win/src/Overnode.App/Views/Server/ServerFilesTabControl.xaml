<UserControl
    x:Class="Overnode.App.Views.Server.ServerFilesTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Overnode.App.Views.Server"
    xmlns:converters="using:Overnode.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

        <MenuFlyout x:Key="FileRowMenuFlyout">
            <!-- File items -->
            <MenuFlyoutItem x:Name="MenuOpenFileExternal" Tag="file_only" Text="Ouvrir dans un éditeur externe" Click="OnContextMenuOpenExternalClicked">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7AC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuChooseEditor" Tag="file_only" Text="Choisir un autre éditeur..." Click="OnContextMenuChooseEditorClicked">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuOpenFileInternal" Tag="file_only" Text="Ouvrir dans l'éditeur intégré" Click="OnContextMenuOpenInternalClicked">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE737;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <!-- Folder items -->
            <MenuFlyoutItem x:Name="MenuOpenFolder" Tag="folder_only" Text="Ouvrir ce dossier" Click="OnContextMenuOpenFolderClicked">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuSyncEnable" Tag="nosync_only" Text="Synchroniser avec un dossier local..." Click="OnContextMenuSyncEnableClicked">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8D5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuSyncOpenExplorer" Tag="sync_only" Text="Afficher dans l'Explorateur de fichiers" Click="OnContextMenuSyncOpenExplorerClicked">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuSyncForce" Tag="sync_only" Text="Synchroniser maintenant" Click="OnContextMenuSyncForceClicked">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuSyncStop" Tag="sync_only" Text="Arrêter la synchronisation" Click="OnContextMenuSyncStopClicked" Foreground="{StaticResource OvernodeAccentDangerBrush}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="MenuDelete" Text="Supprimer" Click="OnContextMenuDeleteClicked" Foreground="{StaticResource OvernodeAccentDangerBrush}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid Background="Transparent"
          AllowDrop="True"
          DragEnter="OnFileBrowserDragEnter"
          DragOver="OnFileBrowserDragOver"
          DragLeave="OnFileBrowserDragLeave"
          Drop="OnFileBrowserDrop">
        <!-- Normal Files Browser View -->
        <StackPanel x:Name="FileBrowserContainer"
                    Spacing="14"
                    AllowDrop="True"
                    DragEnter="OnFileBrowserDragEnter"
                    DragOver="OnFileBrowserDragOver"
                    DragLeave="OnFileBrowserDragLeave"
                    Drop="OnFileBrowserDrop">
            <!-- Breadcrumbs & Actions Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Parent Dir Button -->
                    <Button x:Name="ParentDirBtn"
                            Click="OnParentDirClicked"
                            Visibility="Collapsed"
                            Background="#201F232B"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="10,6"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="11" />
                            <TextBlock x:Name="ParentDirText" Text="Dossier parent" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Path Display -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        <TextBlock x:Name="CurrentDirText"
                                   Text="/"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons: Refresh, New Folder -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnRefreshFilesClicked"
                            Background="#201F232B"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="8"
                            CornerRadius="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </Button>

                    <Button x:Name="NewFolderBtn"
                            Background="{StaticResource OvernodeCardBrush}"
                            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="12,6"
                            CornerRadius="6">
                        <Button.Flyout>
                            <Flyout x:Name="NewFolderFlyout">
                                <StackPanel Width="240" Spacing="10" Padding="4">
                                    <TextBlock x:Name="NewFolderDialogTitle" Text="Nouveau dossier" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="NewFolderNameBox" PlaceholderText="Nom du dossier..." />
                                    <Button Click="OnCreateFolderConfirmed"
                                            Background="{StaticResource OvernodeAccentGoldBrush}"
                                            Foreground="Black"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="CreateFolderBtnText" Text="Créer" HorizontalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="12" Foreground="White" />
                            <TextBlock x:Name="NewFolderText" Text="Nouveau dossier" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Feedback Banners -->
            <Border x:Name="FileSuccessBanner"
                    Visibility="Collapsed"
                    Background="#1A10B981"
                    BorderBrush="#4D10B981"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#10B981" />
                    <TextBlock x:Name="FileSuccessText" Text="" FontSize="12" Foreground="#10B981" />
                </StackPanel>
            </Border>

            <Border x:Name="FileErrorBanner"
                    Visibility="Collapsed"
                    Background="#1AEF4444"
                    BorderBrush="#4DEF4444"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="#EF4444" />
                    <TextBlock x:Name="FileErrorText" Text="" FontSize="12" Foreground="#EF4444" />
                </StackPanel>
            </Border>

            <!-- Upload Progress Banner -->
            <Border x:Name="UploadProgressCard"
                    Visibility="Collapsed"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" VerticalAlignment="Center">
                        <ProgressRing x:Name="UploadProgressRing" IsActive="True" Width="14" Height="14" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        <TextBlock x:Name="UploadProgressText" Text="Téléversement en cours..." FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UploadProgressPercentText" Text="0%" FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource OvernodeTextSecondaryBrush}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="UploadProgressBar" Value="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                </Grid>
            </Border>

            <!-- Loading State -->
            <Border x:Name="FilesLoadingContainer"
                    Visibility="Collapsed"
                    Height="240"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <ProgressRing IsActive="True" Width="28" Height="28" />
                    <TextBlock x:Name="FilesLoadingText" Text="Chargement des fichiers..." FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <Border x:Name="FilesEmptyContainer"
                    Visibility="Collapsed"
                    Height="240"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{StaticResource OvernodeTextMutedBrush}" />
                    <TextBlock x:Name="FilesEmptyText" Text="Ce dossier est vide" FontSize="13" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Files List -->
            <Border x:Name="FilesListContainer"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    AllowDrop="True"
                    DragEnter="OnFileBrowserDragEnter"
                    DragOver="OnFileBrowserDragOver"
                    DragLeave="OnFileBrowserDragLeave"
                    Drop="OnFileBrowserDrop">
                <ItemsControl x:Name="FilesItemsControl"
                              AllowDrop="True"
                              DragEnter="OnFileBrowserDragEnter"
                              DragOver="OnFileBrowserDragOver"
                              DragLeave="OnFileBrowserDragLeave"
                              Drop="OnFileBrowserDrop">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnFileRowClicked"
                                    DoubleTapped="OnFileRowDoubleTapped"
                                    ContextRequested="OnFileRowContextRequested"
                                    RightTapped="OnFileRowRightTapped"
                                    AllowDrop="True"
                                    DragEnter="OnFileBrowserDragEnter"
                                    DragOver="OnFileBrowserDragOver"
                                    DragLeave="OnFileBrowserDragLeave"
                                    Drop="OnFileBrowserDrop"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="12,9"
                                    Margin="0,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <FontIcon Grid.Column="0"
                                              Glyph="{Binding IconGlyph}"
                                              FontSize="15"
                                              Foreground="{StaticResource OvernodeAccentGoldBrush}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center" />

                                    <!-- Name & Sync Badge -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Badge de synchronisation dossier actif -->
                                        <Border Visibility="{Binding IsSynced, Converter={StaticResource BoolToVis}}"
                                                Background="#1A10B981"
                                                BorderBrush="#4D10B981"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8D5;" FontSize="9" Foreground="#10B981" />
                                                <TextBlock Text="{Binding SyncBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedSize}"
                                               FontSize="11"
                                               FontFamily="Consolas, Segoe UI"
                                               Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,16,0" />

                                    <!-- Chevron or dots -->
                                    <FontIcon Grid.Column="3"
                                              Glyph="&#xE76C;"
                                              FontSize="10"
                                              Foreground="{StaticResource OvernodeTextMutedBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- Built-in File Editor Overlay -->
        <Border x:Name="FileEditorContainer"
                Visibility="Collapsed"
                Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="420" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Editor Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        <TextBlock x:Name="EditingFileNameText"
                                   Text="filename.txt"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   FontFamily="Consolas, Segoe UI" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnCancelEditClicked"
                                Background="Transparent"
                                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="12,6"
                                CornerRadius="6">
                            <TextBlock x:Name="CancelEditText" Text="Fermer" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </Button>

                        <Button Click="OnSaveFileClicked"
                                Background="{StaticResource OvernodeAccentGoldBrush}"
                                Foreground="Black"
                                FontWeight="SemiBold"
                                Padding="16,6"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="11" />
                                <TextBlock x:Name="SaveFileText" Text="Enregistrer" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Editor Text Box -->
                <TextBox x:Name="FileEditorTextBox"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         Background="#0C0E14"
                         Foreground="#CBD5E1"
                         BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                         BorderThickness="1"
                         CornerRadius="6"
                         Padding="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <!-- Editor Footer -->
                <TextBlock Grid.Row="2"
                           x:Name="EditorSaveStatusText"
                           Text=""
                           FontSize="11"
                           Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>

        <!-- Drag & Drop Full Overlay -->
        <Border x:Name="FileDropOverlay"
                Visibility="Collapsed"
                Background="#E60B0D13"
                BorderBrush="{StaticResource OvernodeAccentGoldBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Margin="2"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE898;" FontSize="42" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                <TextBlock x:Name="DropOverlayTitleText"
                           Text="Déposez vos fichiers ou dossiers ici pour les téléverser"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="DropOverlaySubtitleText"
                           Text="Les éléments seront automatiquement téléversés sur Overnode"
                           FontSize="12"
                           Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
