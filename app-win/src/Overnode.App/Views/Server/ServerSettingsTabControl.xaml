<UserControl
    x:Class="Overnode.App.Views.Server.ServerSettingsTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <!-- Section 1: Rename Server -->
        <Border Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <StackPanel Spacing="12">
                <TextBlock x:Name="RenameTitleText" Text="Renommer le serveur" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ServerNameTextBox"
                             Grid.Column="0"
                             PlaceholderText="Nouveau nom du serveur..." />

                    <Button Grid.Column="1"
                            Click="OnRenameClicked"
                            Background="{StaticResource OvernodeAccentGoldBrush}"
                            Foreground="Black"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Padding="16,7"
                            CornerRadius="6">
                        <TextBlock x:Name="RenameBtnText" Text="Renommer" />
                    </Button>
                </Grid>

                <Border x:Name="RenameSuccessBanner"
                        Visibility="Collapsed"
                        Background="#1A10B981"
                        BorderBrush="#4D10B981"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6">
                    <TextBlock x:Name="RenameSuccessText" Text="Serveur renommé avec succès !" FontSize="12" Foreground="#10B981" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Section 2: Startup Variables -->
        <Border x:Name="VariablesSection"
                Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <StackPanel Spacing="14">
                <TextBlock x:Name="VariablesTitleText" Text="Variables de démarrage" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />

                <ItemsControl x:Name="VariablesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#12FFFFFF"
                                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding EnvVariable}" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{StaticResource OvernodeTextMutedBrush}" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="VarValueBox"
                                                 Grid.Column="0"
                                                 Text="{Binding ServerValue, Mode=TwoWay}" />

                                        <Button Grid.Column="1"
                                                Click="OnUpdateVariableClicked"
                                                Background="#201F232B"
                                                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                                                BorderThickness="1"
                                                Padding="12,6"
                                                CornerRadius="6">
                                            <TextBlock Text="{Binding UpdateButtonText}" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Section 3: Danger Zone -->
        <Border Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="#4DEF4444"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <StackPanel Spacing="16">
                <TextBlock x:Name="DangerZoneTitleText" Text="Zone Critique" FontSize="15" FontWeight="SemiBold" Foreground="#EF4444" />

                <!-- Reinstall -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="ReinstallTitleText" Text="Réinstaller le serveur" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        <TextBlock x:Name="ReinstallDescText"
                                   Text="Réinitialise les fichiers de base du serveur tout en conservant vos configurations."
                                   FontSize="11"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="OnReinstallClicked"
                            Background="#26EF4444"
                            BorderBrush="#4DEF4444"
                            BorderThickness="1"
                            Padding="14,7"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ReinstallBtnText" Text="Réinstaller" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" />
                    </Button>
                </Grid>

                <Rectangle Height="1" Fill="#15EF4444" />

                <!-- Delete Server -->
                <Grid x:Name="DeleteServerGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="DeleteTitleText" Text="Supprimer le serveur" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        <TextBlock x:Name="DeleteDescText"
                                   Text="Supprime définitivement ce serveur et toutes ses données. Les ressources seront restituées."
                                   FontSize="11"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="OnDeleteClicked"
                            Background="#EF4444"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Padding="14,7"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                            <TextBlock x:Name="DeleteBtnText" Text="Supprimer définitivement" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Delete Locked Banner (if !isOwner) -->
                <StackPanel x:Name="DeleteLockedPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource OvernodeTextMutedBrush}" />
                    <TextBlock x:Name="DeleteLockedText" Text="Seul le propriétaire du serveur peut le supprimer." FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
