<UserControl
    x:Class="Overnode.App.Views.Server.ServerDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:serverViews="using:Overnode.App.Views.Server"
    mc:Ignorable="d">

    <Grid Background="{StaticResource OvernodeBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar with Power Controls -->
        <Border Grid.Row="0"
                Background="{StaticResource OvernodeCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status dot, Server Name, Identifier, Shared badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Status dot -->
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#40C780" VerticalAlignment="Center" />

                    <!-- Server Name -->
                    <TextBlock x:Name="ServerNameText"
                               Text="Mon Serveur"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Identifier chip -->
                    <Border Background="#1F232B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="ServerIdentifierText"
                                   Text="ab12cd34"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource OvernodeTextMutedBrush}" />
                    </Border>

                    <!-- Shared badge -->
                    <Border x:Name="SharedBadge"
                            Visibility="Collapsed"
                            Background="#1FF59E0B"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE716;" FontSize="9" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            <TextBlock x:Name="SharedBadgeText" Text="Partagé" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Power Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Start (Play) -->
                    <Button x:Name="StartBtn"
                            Click="OnStartClicked"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="6"
                            Background="#D910B981"
                            BorderThickness="0">
                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="White" />
                    </Button>

                    <!-- Restart (Arrow Clockwise) -->
                    <Button x:Name="RestartBtn"
                            Click="OnRestartClicked"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="6"
                            Background="#D9F59E0B"
                            BorderThickness="0">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="White" />
                    </Button>

                    <!-- Stop (Square) -->
                    <Button x:Name="StopBtn"
                            Click="OnStopClicked"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="6"
                            Background="#D9EF4444"
                            BorderThickness="0">
                        <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="White" />
                    </Button>

                    <!-- Kill (Bolt) -->
                    <Button x:Name="KillBtn"
                            Click="OnKillClicked"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="6"
                            Background="#D9991B1B"
                            BorderThickness="0">
                        <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Content Body -->
        <ScrollViewer Grid.Row="1"
                      Padding="24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <serverViews:ServerConsoleTabControl x:Name="ConsoleTab" Visibility="Collapsed" />
                <serverViews:ServerRenewalTabControl x:Name="RenewalTab" Visibility="Collapsed" />
                <serverViews:ServerFilesTabControl x:Name="FilesTab" Visibility="Collapsed" />
                <serverViews:ServerSubdomainsTabControl x:Name="SubdomainsTab" Visibility="Collapsed" />
                <serverViews:ServerSubusersTabControl x:Name="SubusersTab" Visibility="Collapsed" />
                <serverViews:ServerSettingsTabControl x:Name="SettingsTab" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
