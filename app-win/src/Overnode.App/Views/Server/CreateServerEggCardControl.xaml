<UserControl
    x:Class="Overnode.App.Views.Server.CreateServerEggCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button x:Name="CardButton"
            Click="OnCardClicked"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Padding="0"
            BorderThickness="0"
            Background="Transparent">
        <Border x:Name="CardBorder"
                Background="{StaticResource OvernodeSecondaryCardBrush}"
                BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                MinHeight="90">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Grid.Column="0"
                        x:Name="IconContainer"
                        Width="40" Height="40"
                        CornerRadius="8"
                        Background="#10FFFFFF"
                        VerticalAlignment="Top">
                    <FontIcon x:Name="EggIcon"
                              Glyph="&#xE7B8;"
                              FontSize="18"
                              Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                </Border>

                <!-- Content -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="EggNameText"
                                       Text="Egg Name"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- God Pack Badge -->
                            <Border x:Name="GodPackBadge"
                                    Visibility="Collapsed"
                                    Background="#25F59E0B"
                                    BorderBrush="{StaticResource OvernodeAccentGoldBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon Glyph="&#xE735;" FontSize="8.5" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                    <TextBlock x:Name="GodPackBadgeText"
                                               Text="God Pack"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Lock Badge when user lacks God Pack -->
                            <Border x:Name="GodPackLockBadge"
                                    Visibility="Collapsed"
                                    Background="#25EF4444"
                                    BorderBrush="#60EF4444"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="8.5" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Checkmark when selected -->
                        <Border Grid.Column="1"
                                x:Name="SelectedCheckBadge"
                                Visibility="Collapsed"
                                Width="18" Height="18"
                                CornerRadius="9"
                                Background="{StaticResource OvernodeAccentGoldBrush}">
                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#000000" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="EggDescriptionText"
                               Text="Description"
                               FontSize="11"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />

                    <!-- Spec Pills -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEB05;" FontSize="9" Foreground="{StaticResource OvernodeGaugeRamBrush}" />
                                <TextBlock x:Name="RamSpecText" Text="1024 MB" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE950;" FontSize="9" Foreground="{StaticResource OvernodeGaugeCpuBrush}" />
                                <TextBlock x:Name="CpuSpecText" Text="100%" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8B7;" FontSize="9" Foreground="{StaticResource OvernodeGaugeDiskBrush}" />
                                <TextBlock x:Name="DiskSpecText" Text="2048 MB" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Button>
</UserControl>
