<UserControl
    x:Class="Overnode.App.Views.AFK.AFKView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Text="Session AFK" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText" Text="Gagnez des coins automatiquement pendant que votre application reste ouverte" FontSize="13" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
            </StackPanel>

            <!-- Active AFK Card -->
            <Border Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#26F59E0B" Margin="0,0,14,0">
                            <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="CardTitle" Text="Gains passifs de Coins" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="CardRate" Text="1 coin toutes les 15 minutes d'activité" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Live Status Indicator -->
                        <Border Grid.Column="2" Background="#2022C55E" BorderBrush="#4022C55E" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource OvernodeAccentSuccessBrush}" />
                                <TextBlock Text="Session Active" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="CardDesc"
                               Text="Laissez Overnode ouvert sur votre ordinateur pour accumuler des coins utilisables dans la boutique ou pour prolonger vos serveurs cloud."
                               FontSize="13"
                               Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                               LineHeight="20"
                               TextWrapping="Wrap" />

                    <!-- Feature checkmarks -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                            <TextBlock x:Name="Feature1" Text="Accumulation automatique sans interruption" FontSize="12.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                            <TextBlock x:Name="Feature2" Text="Protection anti-déconnexion native active" FontSize="12.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                            <TextBlock x:Name="Feature3" Text="Synchronisation instantanée avec votre solde Overnode" FontSize="12.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Open Web AFK Button -->
                    <Button Click="OnOpenWebAFKClicked"
                            HorizontalAlignment="Stretch"
                            Padding="0,10"
                            Background="#FFFFFF"
                            Foreground="#000000"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="13" FontWeight="Bold" />
                            <TextBlock x:Name="BtnOpenText" Text="Ouvrir la session AFK Web" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="FootnoteText" Text="* Les sessions AFK sont soumises aux conditions d'utilisation Overnode." FontSize="11" Foreground="{StaticResource OvernodeTextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
