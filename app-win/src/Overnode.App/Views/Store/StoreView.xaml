<UserControl
    x:Class="Overnode.App.Views.Store.StoreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24">
            <!-- Header section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="TitleText" Text="Boutique" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText" Text="Achetez des ressources avec vos coins ou découvrez nos abonnements" FontSize="13" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>

                <!-- Coin Balance Pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource OvernodeCardBrush}"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource OvernodeAccentGoldBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE735;" FontSize="9" Foreground="#0B0D13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="UserCoinsText" Text="350 coins" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Subtabs bar -->
            <Border BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TabResourcesBtn" Click="OnTabResourcesClicked" Padding="14,8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9E9;" FontSize="12" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            <TextBlock x:Name="TabResourcesText" Text="Ressources" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TabBundlesBtn" Click="OnTabBundlesClicked" Padding="14,8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            <TextBlock x:Name="TabBundlesText" Text="Abonnements &amp; Packs" FontSize="13" FontWeight="Normal" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Success Banner -->
            <Border x:Name="SuccessBanner"
                    Visibility="Collapsed"
                    Background="#2022C55E"
                    BorderBrush="#6022C55E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                    <TextBlock x:Name="SuccessBannerText" Text="Achat réussi !" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                </StackPanel>
            </Border>

            <!-- Tab 1: Resources Grid -->
            <Grid x:Name="ResourcesPanel" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- RAM Card -->
                <Border Grid.Column="0" Background="{StaticResource OvernodeCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#26598CF2" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xEB05;" FontSize="16" Foreground="{StaticResource OvernodeGaugeRamBrush}" />
                        </Border>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="RamTitle" Text="Mémoire RAM" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="RamDesc" Text="+1024 Mo de mémoire vive" FontSize="11.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="RamPriceText" Text="600 coins" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeGaugeRamBrush}" />
                        <Button x:Name="BuyRamBtn" Click="OnBuyRamClicked" HorizontalAlignment="Stretch" Padding="0,8" Background="#15FFFFFF" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="Acheter" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Storage Card -->
                <Border Grid.Column="1" Background="{StaticResource OvernodeCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#2640C780" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{StaticResource OvernodeGaugeDiskBrush}" />
                        </Border>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="DiskTitle" Text="Stockage SSD" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="DiskDesc" Text="+5120 Mo d'espace NVMe" FontSize="11.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DiskPriceText" Text="400 coins" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeGaugeDiskBrush}" />
                        <Button x:Name="BuyDiskBtn" Click="OnBuyDiskClicked" HorizontalAlignment="Stretch" Padding="0,8" Background="#15FFFFFF" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="Acheter" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CPU Card -->
                <Border Grid.Column="2" Background="{StaticResource OvernodeCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#2633BFE0" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{StaticResource OvernodeGaugeCpuBrush}" />
                        </Border>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="CpuTitle" Text="Processeur CPU" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="CpuDesc" Text="+100% de puissance processeur" FontSize="11.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="CpuPriceText" Text="500 coins" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeGaugeCpuBrush}" />
                        <Button x:Name="BuyCpuBtn" Click="OnBuyCpuClicked" HorizontalAlignment="Stretch" Padding="0,8" Background="#15FFFFFF" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="Acheter" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Servers Card -->
                <Border Grid.Column="3" Background="{StaticResource OvernodeCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#269473EB" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{StaticResource OvernodeGaugeServersBrush}" />
                        </Border>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="ServersTitle" Text="Slot Serveur" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                            <TextBlock x:Name="ServersDesc" Text="+1 serveur supplémentaire" FontSize="11.5" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="ServersPriceText" Text="200 coins" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeGaugeServersBrush}" />
                        <Button x:Name="BuyServersBtn" Click="OnBuyServersClicked" HorizontalAlignment="Stretch" Padding="0,8" Background="#15FFFFFF" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="Acheter" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tab 2: Bundles Panel -->
            <Grid x:Name="BundlesPanel" ColumnSpacing="16" RowSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
