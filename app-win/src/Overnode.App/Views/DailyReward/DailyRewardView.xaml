<UserControl
    x:Class="Overnode.App.Views.DailyReward.DailyRewardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24">
            <!-- Header section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="TitleText" Text="Récompense Quotidienne" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText" Text="Connectez-vous chaque jour pour récupérer des coins gratuits et maintenir votre série" FontSize="13" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Click="OnRefreshClicked"
                        Background="#201F232B"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="8"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Subtabs bar -->
            <Border BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TabClaimBtn" Click="OnTabClaimClicked" Padding="14,8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F8;" FontSize="12" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                            <TextBlock x:Name="TabClaimText" Text="Réclamer" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TabHistoryBtn" Click="OnTabHistoryClicked" Padding="14,8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            <TextBlock x:Name="TabHistoryText" Text="Historique" FontSize="13" FontWeight="Normal" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TabLeaderboardBtn" Click="OnTabLeaderboardClicked" Padding="14,8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            <TextBlock x:Name="TabLeaderboardText" Text="Classement" FontSize="13" FontWeight="Normal" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Loading Indicator -->
            <ProgressRing x:Name="LoadingSpinner" IsActive="True" Width="32" Height="32" Visibility="Collapsed" HorizontalAlignment="Center" Foreground="{StaticResource OvernodeAccentGoldBrush}" />

            <!-- Tab 1: Claim Panel -->
            <StackPanel x:Name="ClaimPanel" Spacing="20">
                <!-- Success Banner -->
                <Border x:Name="SuccessBanner"
                        Visibility="Collapsed"
                        Background="#2022C55E"
                        BorderBrush="#6022C55E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                        <TextBlock x:Name="SuccessBannerText" Text="Récompense réclamée !" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource OvernodeAccentSuccessBrush}" />
                    </StackPanel>
                </Border>

                <!-- Hero Claim Card -->
                <Border Background="{StaticResource OvernodeCardBrush}"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#26F59E0B">
                                    <FontIcon Glyph="&#xE8F8;" FontSize="20" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="HeroTitle" Text="Récompense du jour" FontSize="17" FontWeight="Bold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                                    <TextBlock x:Name="HeroStreakText" Text="Série en cours : 6 jours consécutifs" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="HeroRewardAmount" Text="+87" FontSize="36" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                <TextBlock Text="coins" FontSize="16" Foreground="{StaticResource OvernodeTextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>

                            <!-- Milestone Badge -->
                            <Border x:Name="MilestoneBadge"
                                    Background="#20F59E0B"
                                    BorderBrush="#40F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                    <TextBlock x:Name="MilestoneText" Text="Bonus série hebdomadaire ! +50 coins" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Claim Button -->
                        <Button Grid.Column="1"
                                x:Name="ClaimButton"
                                Click="OnClaimClicked"
                                VerticalAlignment="Center"
                                Padding="28,14"
                                Background="{StaticResource OvernodeAccentGoldBrush}"
                                BorderThickness="0"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="ClaimSpinner" Visibility="Collapsed" Width="14" Height="14" Foreground="#000000" IsActive="True" />
                                <FontIcon x:Name="ClaimIcon" Glyph="&#xE735;" FontSize="13" Foreground="#000000" FontWeight="Bold" />
                                <TextBlock x:Name="ClaimButtonText" Text="Réclamer maintenant" FontSize="14" FontWeight="Bold" Foreground="#000000" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Stats 3-column Grid -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Stat 1: Current Streak -->
                    <Border Grid.Column="0" Background="{StaticResource OvernodeCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                <TextBlock x:Name="StatCurrentStreakTitle" Text="Série Actuelle" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="StatCurrentStreakValue" Text="6 jours" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Stat 2: Longest Streak -->
                    <Border Grid.Column="1" Background="{StaticResource OvernodeCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="{StaticResource OvernodeGaugeServersBrush}" />
                                <TextBlock x:Name="StatLongestStreakTitle" Text="Meilleure Série" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="StatLongestStreakValue" Text="12 jours" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Stat 3: Total Earned -->
                    <Border Grid.Column="2" Background="{StaticResource OvernodeCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{StaticResource OvernodeAccentGoldBrush}" />
                                <TextBlock x:Name="StatTotalEarnedTitle" Text="Total Gagné" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="StatTotalEarnedValue" Text="1 150 coins" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Tab 2: History Panel -->
            <Border x:Name="HistoryPanel"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                <StackPanel Spacing="0">
                    <Border Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Série" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Récompense" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="HistoryRows" />
                </StackPanel>
            </Border>

            <!-- Tab 3: Leaderboard Panel -->
            <Border x:Name="LeaderboardPanel"
                    Background="{StaticResource OvernodeCardBrush}"
                    BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                <StackPanel Spacing="0">
                    <Border Background="{StaticResource OvernodeSecondaryCardBrush}" BorderBrush="{StaticResource OvernodeBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rang" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Utilisateur" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Série" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OvernodeTextSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="LeaderboardRows" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
