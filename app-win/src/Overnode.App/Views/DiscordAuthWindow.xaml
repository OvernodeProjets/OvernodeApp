<Window
    x:Class="Overnode.App.Views.DiscordAuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Connexion - Overnode">

    <Grid Background="#101218">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#181B22" BorderBrush="#2E3337" BorderThickness="0,0,0,1">
            <Grid Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#F59E0B" />
                    <TextBlock Text="Connexion Sécurisée" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Foreground="#FFFFFF" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton" 
                        Click="CloseButton_Click" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#95A1AD" />
                </Button>
            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <ProgressRing x:Name="LoadingRing" 
                      Grid.Row="1" 
                      IsActive="True" 
                      Width="48" 
                      Height="48" 
                      Foreground="#F59E0B" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center" />

        <!-- WebView2 Control -->
        <WebView2 x:Name="AuthWebView" 
                  Grid.Row="1" 
                  Visibility="Collapsed" />
    </Grid>
</Window>
