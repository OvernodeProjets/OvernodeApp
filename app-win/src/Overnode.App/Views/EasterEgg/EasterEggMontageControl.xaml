<UserControl
    x:Class="Overnode.App.Views.EasterEgg.EasterEggMontageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer" Background="#0C0A14">
        <!-- Fond stroboscopique réactif au beat -->
        <Border x:Name="StrobeBorder" Background="White" Opacity="0" IsHitTestVisible="False" />

        <!-- Canvas des faisceaux laser disco -->
        <Canvas x:Name="LaserCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Canvas de la pluie de chats (Falling rain) -->
        <Canvas x:Name="RainCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" />

        <!-- Contenu principal -->
        <Grid Padding="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BARRE SUPÉRIEURE -->
            <Border Grid.Row="0" Background="#73000000" CornerRadius="16" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Visualiseur audio 16 barres + Titre -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <!-- Barres de l'égaliseur -->
                        <StackPanel x:Name="VisualizerContainer" Orientation="Horizontal" Spacing="3" Height="32" VerticalAlignment="Center" />

                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="🐱 DANCING RAT x OIIA CAT" FontSize="14" FontWeight="Black" Foreground="White" />
                            <TextBlock x:Name="PhaseTitleText" Text="👑 L'ÉVEIL DU CHAT OVERNODE" FontSize="11" FontWeight="Bold" Foreground="#E5B842" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Badge chats invoqués et bouton Quitter -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border x:Name="SummonedBadge" Background="#25FFFFFF" CornerRadius="20" Padding="12,6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🐾" FontSize="12" />
                                <TextBlock x:Name="SummonedCountText" Text="0 chats invoqués" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="QuitButton" Click="OnQuitClicked"
                                Background="#D32F2F" Foreground="White" CornerRadius="10" Padding="14,8" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock x:Name="QuitButtonText" Text="Quitter (Échap)" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SCÈNE CENTRALE (Selon la phase) -->
            <Grid Grid.Row="1" x:Name="StageContainer" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Phase 1: Intro -->
                <StackPanel x:Name="StageIntro" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Height="360">
                        <!-- Halo doré rotatif -->
                        <Border x:Name="IntroHalo" Width="320" Height="320" CornerRadius="160" Opacity="0.45"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFE5B842" Offset="0" />
                                    <GradientStop Color="#FFFF5722" Offset="0.3" />
                                    <GradientStop Color="#FFE91E63" Offset="0.7" />
                                    <GradientStop Color="#FF9C27B0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Couronne dorée flottante -->
                        <TextBlock Text="👑" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" />

                        <!-- Chat Loaf (cat_02) -->
                        <Image x:Name="IntroCatImage" Width="280" Height="280" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock x:Name="IntroBannerText" Text="LE CHAT OVERNODE A PRIS LE CONTRÔLE"
                                   FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock x:Name="IntroHintText" Text="Montez le son, installez-vous confortablement. 1m04 de dinguerie."
                                   FontSize="13" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Phase 2: Dancing Rat Groove -->
                <StackPanel x:Name="StageDancing" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="36" HorizontalAlignment="Center">
                        <!-- Danseur Gauche: DJ Juge (cat_01) -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Image x:Name="DancerJudgeImage" Width="170" Height="170" Stretch="Uniform" />
                            <TextBlock x:Name="DancerJudgeText" Text="DJ Juge" FontSize="13" FontWeight="Bold" Foreground="#E5B842" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Danseur Centre: Breakdancer Suprême (cat_06) -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Image x:Name="DancerBreakImage" Width="260" Height="260" Stretch="Uniform" />
                            <TextBlock x:Name="DancerBreakText" Text="Breakdancer Suprême" FontSize="15" FontWeight="Black" Foreground="#00E5FF" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Danseur Droite: Patte de Velours (cat_07) -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Image x:Name="DancerPawImage" Width="170" Height="170" Stretch="Uniform" />
                            <TextBlock x:Name="DancerPawText" Text="Patte de Velours" FontSize="13" FontWeight="Bold" Foreground="#E5B842" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Punchline Ticker -->
                    <Border Background="#80000000" CornerRadius="20" Padding="20,8" BorderBrush="#90E5B842" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="MemeTickerText" Text="🎶 You're free to do what you want to do... MIAOU 🎶"
                                   FontSize="14" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Phase 3: Turbo Oiia Oiia -->
                <Grid x:Name="StageOiia" Width="600" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Satellites orbitaux autour du centre -->
                    <Canvas x:Name="SatellitesCanvas" Width="600" Height="500" IsHitTestVisible="False" />

                    <!-- Chat central rotatif supersonique -->
                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="OiiaSpinCatImage" Width="240" Height="240" Stretch="Uniform" />
                        <TextBlock Text="🌀 OIIA OIIA OIIA OIIA 🌀" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Phase 4: Disco Chaos Total -->
                <StackPanel x:Name="StageChaos" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="750" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Coin gauche: Sphinx (cat_09) -->
                        <Image x:Name="ChaosCornerLeftImage" Grid.Column="0" Width="120" Height="120" Stretch="Uniform" VerticalAlignment="Center" />

                        <!-- Centre: Chat changeant à chaque beat -->
                        <Image x:Name="ChaosCenterImage" Grid.Column="1" Width="290" Height="290" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Coin droit: Tête penchée (cat_11) -->
                        <Image x:Name="ChaosCornerRightImage" Grid.Column="2" Width="120" Height="120" Stretch="Uniform" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="ChaosBannerText" Text="🔥 OVERCLOCKING FÉLIN : 9999 MHz"
                               FontSize="24" FontWeight="Black" Foreground="#E5B842" HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                        <Border Background="#25FFFFFF" CornerRadius="8" Padding="10,5">
                            <TextBlock x:Name="BadgeLagText" Text="⚡ 0% Lag, 100% Ronronnement" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Border Background="#25FFFFFF" CornerRadius="8" Padding="10,5">
                            <TextBlock x:Name="BadgeSalmonText" Text="🐟 Alimenté à la pâtée royale" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Border Background="#25FFFFFF" CornerRadius="8" Padding="10,5">
                            <TextBlock x:Name="BadgeSiliconText" Text="🚀 Windows x64 Optimisé" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Phase 5: Finished / Victoire -->
                <Border x:Name="StageFinished" Background="#A0000000" CornerRadius="24" BorderBrush="#90E5B842" BorderThickness="2"
                        Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Spacing="20" HorizontalAlignment="Center">
                        <TextBlock x:Name="VictoryTitleText" Text="🎉 TU AS SURVÉCU À LA DINGUERIE FÉLINE !"
                                   FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />

                        <Image x:Name="VictoryCatImage" Width="230" Height="230" Stretch="Uniform" HorizontalAlignment="Center" />

                        <TextBlock x:Name="VictoryDescText" Text="1 minute et 4 secondes de pure légende féline."
                                   FontSize="15" Foreground="#E0FFFFFF" HorizontalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                            <Button x:Name="RestartButton" Click="OnRestartClicked"
                                    Background="#E5B842" Foreground="#0B0D13" CornerRadius="12" Padding="20,12" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🔁" />
                                    <TextBlock x:Name="RestartBtnText" Text="Recommencer la fête" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BackSettingsButton" Click="OnQuitClicked"
                                    Background="#30FFFFFF" Foreground="White" CornerRadius="12" Padding="20,12" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="↩️" />
                                    <TextBlock x:Name="BackSettingsBtnText" Text="Retourner aux réglages" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BARRE INFÉRIEURE : TIMELINE ET CONTRÔLES -->
            <Border Grid.Row="2" Background="#73000000" CornerRadius="16" Padding="16,12" BorderBrush="#20FFFFFF" BorderThickness="1">
                <StackPanel Spacing="8">
                    <!-- Barre de progression scrubbable -->
                    <Grid Height="20" VerticalAlignment="Center">
                        <ProgressBar x:Name="TimelineProgress" Minimum="0" Maximum="64.6" Value="0" Height="6"
                                     Foreground="#FFE5B842" Background="#30FFFFFF" CornerRadius="3" VerticalAlignment="Center" />
                        <!-- Curseur tête de chat -->
                        <TextBlock x:Name="CatCursorEmoji" Text="🐱" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,-4,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Temps courant -->
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00" FontFamily="Consolas" FontSize="12" Foreground="#B0FFFFFF" VerticalAlignment="Center" />

                        <!-- Boutons Play/Pause et Miaou -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="PlayPauseButton" Click="OnPlayPauseClicked" Background="Transparent" BorderThickness="0" Padding="6">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="22" Foreground="White" />
                            </Button>

                            <Button x:Name="MeowButton" Click="OnMeowClicked" Background="#35FFFFFF" Foreground="White" CornerRadius="8" Padding="12,6" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🐾" />
                                    <TextBlock x:Name="MeowButtonText" Text="Miaou !" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Durée totale -->
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="01:04" FontFamily="Consolas" FontSize="12" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Canvas des particules interactives (Clics souris) -->
        <Canvas x:Name="ParticlesCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
