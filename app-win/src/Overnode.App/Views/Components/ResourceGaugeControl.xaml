<UserControl
    x:Class="Overnode.App.Views.Components.ResourceGaugeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{StaticResource OvernodeCardBrush}"
            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Icon + Title (Left) and Percentage Badge (Right) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#14FFFFFF" VerticalAlignment="Center">
                        <FontIcon x:Name="GaugeIcon"
                                  Glyph="&#xEB05;"
                                  FontSize="13"
                                  Foreground="{StaticResource OvernodeGaugeRamBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="GaugeTitle"
                               Text="Resource"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Percentage pill badge -->
                <Border Grid.Column="1"
                        Background="#14FFFFFF"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="GaugePercentageBadge"
                               Text="0%"
                               FontSize="11"
                               FontWeight="Bold"
                               FontFamily="Consolas, Segoe UI"
                               Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                </Border>
            </Grid>

            <!-- Row 1: Used / Total numeric values -->
            <TextBlock x:Name="GaugeValues"
                       Grid.Row="1"
                       Text="0 / 0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />

            <!-- Row 2: Progress Bar -->
            <Grid Grid.Row="2" Height="5">
                <Rectangle Fill="{StaticResource OvernodeSecondaryCardBrush}"
                           RadiusX="2.5" RadiusY="2.5" />
                <ProgressBar x:Name="GaugeProgress"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="5"
                             Foreground="{StaticResource OvernodeGaugeRamBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             CornerRadius="2.5" />
            </Grid>

            <!-- Row 3: Footer Utilization description -->
            <TextBlock x:Name="GaugeUtilization"
                       Grid.Row="3"
                       Text="0.0% d'utilisation"
                       FontSize="11"
                       Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
