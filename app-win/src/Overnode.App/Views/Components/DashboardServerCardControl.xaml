<UserControl
    x:Class="Overnode.App.Views.Components.DashboardServerCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Overnode.App.Models"
    mc:Ignorable="d">

    <Border Background="{StaticResource OvernodeCardBrush}"
            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">

        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="FlyoutManageItem"
                                Text="Gérer"
                                Click="OnManageClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FlyoutDeleteItem"
                                Text="Supprimer le serveur"
                                Foreground="{StaticResource OvernodeAccentDangerBrush}"
                                Click="OnDeleteClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource OvernodeAccentDangerBrush}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Border.ContextFlyout>

        <StackPanel Spacing="16">
            <!-- Top Header: Server icon, Name + status, and Manage Button -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon 40x40 -->
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        Background="{StaticResource OvernodeSecondaryCardBrush}"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7F8;"
                              FontSize="16"
                              Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Name & Status -->
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ServerNameText"
                                   Text="Server Name"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Shared Badge -->
                        <Border x:Name="SharedBadge"
                                Background="#1FF59E0B"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE716;" FontSize="10" Foreground="{StaticResource OvernodeAccentWarningBrush}" />
                                <TextBlock x:Name="SharedBadgeText"
                                           Text="Partagé"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OvernodeAccentWarningBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Status dot + text -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#22C55E" />
                        <TextBlock x:Name="StatusText"
                                   Text="En ligne"
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Manage Button -->
                <Button Grid.Column="2"
                        Click="OnManageClicked"
                        Background="{StaticResource OvernodeSecondaryCardBrush}"
                        BorderBrush="#1FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ManageButtonText"
                                   Text="Gérer"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                        <FontIcon Glyph="&#xE76C;" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OvernodeTextPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Consumptions lines: Memory, CPU, Disk -->
            <StackPanel Spacing="12">
                <!-- Memory -->
                <StackPanel Spacing="5">
                    <Grid>
                        <TextBlock x:Name="MemoryLabelText"
                                   Text="Memory"
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="MemoryText"
                                   Text="0 / 0 MB"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="MemoryProgress"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="3"
                                 Foreground="{StaticResource OvernodeGaugeRamBrush}"
                                 Background="{StaticResource OvernodeSecondaryCardBrush}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- CPU -->
                <StackPanel Spacing="5">
                    <Grid>
                        <TextBlock x:Name="CpuLabelText"
                                   Text="CPU"
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="CpuText"
                                   Text="0.0 / 0%"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="CpuProgress"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="3"
                                 Foreground="{StaticResource OvernodeGaugeCpuBrush}"
                                 Background="{StaticResource OvernodeSecondaryCardBrush}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- Disk -->
                <StackPanel Spacing="5">
                    <Grid>
                        <TextBlock x:Name="DiskLabelText"
                                   Text="Disk"
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="DiskText"
                                   Text="0 MB / 0 MB"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="12"
                                   Foreground="{StaticResource OvernodeTextPrimaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="DiskProgress"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="3"
                                 Foreground="{StaticResource OvernodeGaugeDiskBrush}"
                                 Background="{StaticResource OvernodeSecondaryCardBrush}"
                                 BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
