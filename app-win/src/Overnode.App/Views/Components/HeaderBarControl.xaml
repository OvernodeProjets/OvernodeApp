<UserControl
    x:Class="Overnode.App.Views.Components.HeaderBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{StaticResource OvernodeCardBrush}"
            BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/overnode_logo.png"
                       Height="24"
                       Stretch="Uniform" />
            </StackPanel>

            <!-- Right: Language Switcher and Refresh -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Language Switcher -->
                <Border Background="{StaticResource OvernodeSecondaryCardBrush}"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="FrButton"
                                Click="OnFrClicked"
                                Padding="8,4"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/flag_fr.png" Width="16" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="FR" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="EnButton"
                                Click="OnEnClicked"
                                Padding="8,4"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/flag_en.png" Width="16" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="EN" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Click="OnRefreshClicked"
                        Background="{StaticResource OvernodeSecondaryCardBrush}"
                        BorderBrush="{StaticResource OvernodeBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        ToolTipService.ToolTip="Actualiser">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource OvernodeTextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
