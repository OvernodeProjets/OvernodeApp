<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Overnode Dark Theme Colors -->
    <Color x:Key="OvernodeBackgroundColor">#101218</Color>
    <Color x:Key="OvernodeCardColor">#181B22</Color>
    <Color x:Key="OvernodeSecondaryCardColor">#202229</Color>
    <Color x:Key="OvernodeBorderColor">#2E3337</Color>
    <Color x:Key="OvernodeBorderSubtleColor">#262B35</Color>
    <Color x:Key="OvernodeTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OvernodeTextSecondaryColor">#95A1AD</Color>
    <Color x:Key="OvernodeTextMutedColor">#66707D</Color>

    <!-- Accents -->
    <Color x:Key="OvernodeAccentGoldColor">#F59E0B</Color>
    <Color x:Key="OvernodeAccentDiscordColor">#5865F2</Color>
    <Color x:Key="OvernodeAccentSuccessColor">#22C55E</Color>
    <Color x:Key="OvernodeAccentDangerColor">#EF4444</Color>
    <Color x:Key="OvernodeAccentWarningColor">#F59E0B</Color>

    <!-- Resource Gauge Accents -->
    <Color x:Key="OvernodeGaugeRamColor">#598CF2</Color>
    <Color x:Key="OvernodeGaugeCpuColor">#33BFE0</Color>
    <Color x:Key="OvernodeGaugeDiskColor">#40C780</Color>
    <Color x:Key="OvernodeGaugeServersColor">#9473EB</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="OvernodeBackgroundBrush" Color="{StaticResource OvernodeBackgroundColor}" />
    <SolidColorBrush x:Key="OvernodeCardBrush" Color="{StaticResource OvernodeCardColor}" />
    <SolidColorBrush x:Key="OvernodeSecondaryCardBrush" Color="{StaticResource OvernodeSecondaryCardColor}" />
    <SolidColorBrush x:Key="OvernodeBorderBrush" Color="{StaticResource OvernodeBorderColor}" />
    <SolidColorBrush x:Key="OvernodeBorderSubtleBrush" Color="{StaticResource OvernodeBorderSubtleColor}" />
    <SolidColorBrush x:Key="OvernodeTextPrimaryBrush" Color="{StaticResource OvernodeTextPrimaryColor}" />
    <SolidColorBrush x:Key="OvernodeTextSecondaryBrush" Color="{StaticResource OvernodeTextSecondaryColor}" />
    <SolidColorBrush x:Key="OvernodeTextMutedBrush" Color="{StaticResource OvernodeTextMutedColor}" />
    <SolidColorBrush x:Key="OvernodeAccentGoldBrush" Color="{StaticResource OvernodeAccentGoldColor}" />
    <SolidColorBrush x:Key="OvernodeAccentDiscordBrush" Color="{StaticResource OvernodeAccentDiscordColor}" />
    <SolidColorBrush x:Key="OvernodeAccentSuccessBrush" Color="{StaticResource OvernodeAccentSuccessColor}" />
    <SolidColorBrush x:Key="OvernodeAccentDangerBrush" Color="{StaticResource OvernodeAccentDangerColor}" />
    <SolidColorBrush x:Key="OvernodeAccentWarningBrush" Color="{StaticResource OvernodeAccentWarningColor}" />

    <SolidColorBrush x:Key="OvernodeGaugeRamBrush" Color="{StaticResource OvernodeGaugeRamColor}" />
    <SolidColorBrush x:Key="OvernodeGaugeCpuBrush" Color="{StaticResource OvernodeGaugeCpuColor}" />
    <SolidColorBrush x:Key="OvernodeGaugeDiskBrush" Color="{StaticResource OvernodeGaugeDiskColor}" />
    <SolidColorBrush x:Key="OvernodeGaugeServersBrush" Color="{StaticResource OvernodeGaugeServersColor}" />

    <!-- Global ScrollViewer: hide scrollbars/sliders by default while preserving smooth scrolling -->
    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

</ResourceDictionary>
