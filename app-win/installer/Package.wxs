<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Overnode"
           Manufacturer="Overnode"
           Version="$(var.Version)"
           UpgradeCode="4C66C9E8-3165-4EE6-9F0B-D5D5BF8A88E1"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente d'Overnode est déjà installée." AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" />
    
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\Assets\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://overnode.fr" />
    <Property Id="ARPURLINFOABOUT" Value="https://overnode.fr" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Overnode" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Overnode">
        <Component Id="ProgramMenuShortcutDir" Guid="D206B5BA-0D68-45F4-A016-D277C0E4B774">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="Overnode"
                    Description="Console Cloud Native Overnode"
                    Target="[INSTALLFOLDER]Overnode.App.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="CleanUpShortCut" Directory="ProgramMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Overnode" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="418D1612-421A-4840-A09D-A53A04CF84EE">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="Overnode"
                  Description="Console Cloud Native Overnode"
                  Target="[INSTALLFOLDER]Overnode.App.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Overnode" Name="desktop_installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Overnode" Level="1">
      <Files Include="$(var.PublishDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="ProgramMenuShortcutDir" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
