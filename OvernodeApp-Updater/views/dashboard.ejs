<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OvernodeApp-Updater - Tableau de bord</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif; }
    body {
      background-color: #0b0f19;
      color: #f1f5f9;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      background: rgba(15, 23, 42, 0.9);
      border-bottom: 1px solid #1e293b;
      backdrop-filter: blur(12px);
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-badge {
      background: linear-gradient(135deg, #2563eb, #38bdf8);
      color: white;
      padding: 6px 12px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.5px;
    }
    .brand-title {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
    }
    .brand-sub {
      font-size: 12px;
      color: #94a3b8;
    }
    .user-nav {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .user-pill {
      background: #1e293b;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 13px;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid #334155;
    }
    .user-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
    }
    .btn-logout {
      background: transparent;
      border: 1px solid #334155;
      color: #94a3b8;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 13px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-logout:hover {
      background: rgba(239, 68, 68, 0.15);
      border-color: #ef4444;
      color: #fca5a5;
    }

    main {
      flex: 1;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px;
    }

    .alert {
      padding: 14px 18px;
      border-radius: 10px;
      font-size: 14px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .alert-success {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: #6ee7b7;
    }
    .alert-error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.35);
      color: #fca5a5;
    }

    /* Grid cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }
    .card {
      background: #131b2e;
      border: 1px solid #202c45;
      border-radius: 14px;
      padding: 22px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .card-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #94a3b8;
      margin-bottom: 8px;
    }
    .card-val {
      font-size: 26px;
      font-weight: 700;
      color: #ffffff;
    }
    .val-green { color: #34d399; }
    .val-blue { color: #38bdf8; }
    .val-gold { color: #fbbf24; }
    .card-desc {
      font-size: 12px;
      color: #64748b;
      margin-top: 6px;
    }

    /* GitHub Commit Card */
    .commit-card {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
      border: 1px solid #334155;
      border-radius: 14px;
      padding: 20px 24px;
      margin-bottom: 28px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .commit-meta {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .commit-sha-badge {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.3);
      font-family: 'SF Mono', Menlo, monospace;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 700;
    }
    .commit-msg {
      font-size: 14px;
      font-weight: 600;
      color: #f8fafc;
    }
    .commit-sub {
      font-size: 12px;
      color: #94a3b8;
      margin-top: 2px;
    }

    /* Comparison Banner */
    .compare-banner {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.9));
      border: 1px solid #334155;
      border-radius: 14px;
      padding: 24px;
      margin-bottom: 32px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .compare-banner.has-new {
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(245, 158, 11, 0.12));
      border: 1px solid rgba(245, 158, 11, 0.4);
    }
    .compare-left {
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .compare-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      background: rgba(56, 189, 248, 0.15);
      border: 1px solid rgba(56, 189, 248, 0.3);
    }
    .compare-banner.has-new .compare-icon {
      background: rgba(245, 158, 11, 0.2);
      border-color: rgba(245, 158, 11, 0.4);
    }
    .compare-title {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
    }
    .compare-sub {
      font-size: 13px;
      color: #94a3b8;
      margin-top: 3px;
    }

    /* Push Section */
    .deploy-section {
      background: #131b2e;
      border: 1px solid #202c45;
      border-radius: 14px;
      padding: 28px;
      margin-bottom: 32px;
    }
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .section-title {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-badge {
      font-size: 11px;
      background: rgba(56, 189, 248, 0.12);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 3px 8px;
      border-radius: 6px;
      font-weight: 600;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-bottom: 18px;
    }
    .form-group {
      margin-bottom: 14px;
    }
    label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: #cbd5e1;
      margin-bottom: 6px;
    }
    input[type="text"], textarea {
      width: 100%;
      background: #0b0f19;
      border: 1px solid #2d3b55;
      border-radius: 8px;
      padding: 10px 12px;
      color: #ffffff;
      font-size: 13px;
      outline: none;
      transition: all 0.2s;
    }
    input[type="text"]:focus, textarea:focus {
      border-color: #38bdf8;
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }
    textarea {
      resize: vertical;
      min-height: 80px;
      font-family: inherit;
    }
    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #cbd5e1;
      cursor: pointer;
      margin-top: 10px;
    }
    .btn-push {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      border: none;
      border-radius: 8px;
      padding: 12px 28px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);
      transition: all 0.2s;
    }
    .btn-push:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }

    /* Releases Table */
    .table-container {
      background: #131b2e;
      border: 1px solid #202c45;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 32px;
    }
    .table-header {
      padding: 18px 24px;
      border-bottom: 1px solid #202c45;
      font-size: 16px;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }
    th {
      background: #0f1626;
      color: #94a3b8;
      font-weight: 600;
      padding: 12px 20px;
      border-bottom: 1px solid #202c45;
    }
    td {
      padding: 14px 20px;
      border-bottom: 1px solid #1a2336;
      color: #cbd5e1;
    }
    tr:last-child td { border-bottom: none; }
    .tag-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 12px;
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.25);
    }
    .current-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 12px;
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .btn-select {
      background: #1e293b;
      color: #f1f5f9;
      border: 1px solid #334155;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s;
    }
    .btn-select:hover {
      background: #2563eb;
      border-color: #2563eb;
    }

    /* API Info Box */
    .api-card {
      background: #0d121f;
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 20px;
      font-size: 13px;
    }
    .code-block {
      background: #05070c;
      padding: 12px;
      border-radius: 6px;
      font-family: 'SF Mono', Menlo, monospace;
      color: #38bdf8;
      overflow-x: auto;
      margin-top: 8px;
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <div class="brand-badge">UPDATER</div>
      <div>
        <div class="brand-title">OvernodeApp-Updater</div>
        <div class="brand-sub">Gestionnaire de distribution de l'application macOS</div>
      </div>
    </div>
    <div class="user-nav">
      <div class="user-pill">
        <span class="user-dot"></span>
        <span><%= user.username %></span>
      </div>
      <a href="/auth/logout" class="btn-logout">Déconnexion</a>
    </div>
  </header>

  <main>
    <% if (successMessage) { %>
      <div class="alert alert-success">
        <span>✓</span> <%= successMessage %>
      </div>
    <% } %>
    <% if (errorMessage) { %>
      <div class="alert alert-error">
        <span>⚠</span> <%= errorMessage %>
      </div>
    <% } %>

    <!-- Statistics -->
    <div class="stats-grid">
      <div class="card">
        <div class="card-label">Version en production (App)</div>
        <div class="card-val val-green">v<%= deployment.currentVersion %></div>
        <div class="card-desc">Déployé le <%= new Date(deployment.publishedAt).toLocaleDateString('fr-FR') %></div>
      </div>
      <div class="card">
        <div class="card-label">Dernier Commit GitHub</div>
        <div class="card-val val-blue"><%= latestCommit ? latestCommit.shortSha : (latestRelease ? 'v' + latestRelease.version : 'N/A') %></div>
        <div class="card-desc"><%= repo %></div>
      </div>
      <div class="card">
        <div class="card-label">Statut Déploiement</div>
        <div class="card-val <%= hasNewerRelease ? 'val-gold' : 'val-green' %>">
          <%= hasNewerRelease ? 'Mise à jour prête' : 'À jour' %>
        </div>
        <div class="card-desc">
          <%= hasNewerRelease ? 'Nouvelle version / commit détecté' : 'Les clients ont la version la plus récente' %>
        </div>
      </div>
      <div class="card">
        <div class="card-label">Requêtes de vérification</div>
        <div class="card-val"><%= stats.totalChecks || 0 %></div>
        <div class="card-desc">Appels reçus depuis l'app macOS</div>
      </div>
    </div>

    <!-- Latest GitHub Commit Card -->
    <% if (latestCommit) { %>
      <div class="commit-card">
        <div class="commit-meta">
          <span class="commit-sha-badge"><%= latestCommit.shortSha %></span>
          <div>
            <div class="commit-msg"><%= latestCommit.message.split('\n')[0] %></div>
            <div class="commit-sub">Par <%= latestCommit.authorName %> • <%= new Date(latestCommit.date).toLocaleString('fr-FR') %></div>
          </div>
        </div>
        <button type="button" class="btn-select" 
          onclick="selectRelease('1.1.0', '<%= latestRelease ? latestRelease.downloadUrl : \'https://github.com/\' + repo + \'/releases/download/v1.1.0/Overnode-v1.1.0-macOS-arm64.dmg\' %>', '<%= encodeURIComponent(latestCommit.message) %>')">
          Utiliser ce commit pour Push
        </button>
      </div>
    <% } %>

    <!-- Comparison Banner -->
    <div class="compare-banner <%= hasNewerRelease ? 'has-new' : '' %>">
      <div class="compare-left">
        <div class="compare-icon"><%= hasNewerRelease ? '🚀' : '✨' %></div>
        <div>
          <div class="compare-title">
            <% if (hasNewerRelease) { %>
              Une nouvelle version ou commit est disponible sur GitHub !
            <% } else { %>
              L'application macOS est synchronisée avec la dernière release.
            <% } %>
          </div>
          <div class="compare-sub">
            Version déployée activement : <strong>v<%= deployment.currentVersion %></strong> — Cliquez sur "Push to app" ci-dessous pour rendre la nouvelle version disponible aux utilisateurs.
          </div>
        </div>
      </div>
    </div>

    <!-- Push to App Section -->
    <div class="deploy-section">
      <div class="section-header">
        <div class="section-title">
          <span>🚀</span>
          <span>Déployer vers l'application (Push to app)</span>
        </div>
        <div class="section-badge">ADMINISTRATION</div>
      </div>

      <form action="/deploy" method="POST" id="deployForm">
        <div class="form-grid">
          <div class="form-group">
            <label for="version">Version à déployer</label>
            <input type="text" id="version" name="version" required 
                   value="<%= latestRelease ? latestRelease.version : deployment.currentVersion %>" placeholder="1.1.0">
          </div>
          <div class="form-group">
            <label for="downloadUrl">URL de l'archive (.dmg ou .zip)</label>
            <input type="text" id="downloadUrl" name="downloadUrl" required 
                   value="<%= latestRelease ? latestRelease.downloadUrl : deployment.downloadUrl %>" 
                   placeholder="https://.../Overnode-v1.1.0-macOS-arm64.dmg">
          </div>
        </div>

        <div class="form-group">
          <label for="releaseNotes">Notes de version (Changelog affiché dans l'app)</label>
          <textarea id="releaseNotes" name="releaseNotes" placeholder="Détail des nouveautés et correctifs..."><%= latestRelease ? latestRelease.body : deployment.releaseNotes %></textarea>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="sha256">Somme de contrôle SHA256 (optionnel)</label>
            <input type="text" id="sha256" name="sha256" value="<%= deployment.sha256 || '' %>" placeholder="Hash SHA256 pour vérifier l'intégrité">
          </div>
          <div class="form-group" style="display: flex; align-items: center;">
            <label class="checkbox-label">
              <input type="checkbox" name="mandatory" id="mandatory">
              <span>Mise à jour obligatoire (invite bloquante dans l'app)</span>
            </label>
          </div>
        </div>

        <button type="submit" class="btn-push">
          <span>🚀</span>
          <span>Push to app</span>
        </button>
      </form>
    </div>

    <!-- Available Releases Table -->
    <div class="table-container">
      <div class="table-header">
        <span>Releases & Commits GitHub détectés</span>
        <a href="/" style="color: #38bdf8; text-decoration: none; font-size: 13px;">↻ Rafraîchir</a>
      </div>
      <table>
        <thead>
          <tr>
            <th>Version / Réf</th>
            <th>Titre / Notes</th>
            <th>Fichier</th>
            <th>Date</th>
            <th>Statut</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% releases.forEach(function(rel) { %>
            <tr>
              <td>
                <span class="tag-badge"><%= rel.tag %></span>
              </td>
              <td style="max-width: 320px;">
                <strong><%= rel.name %></strong>
              </td>
              <td><%= rel.assetName || 'DMG / ZIP' %></td>
              <td><%= new Date(rel.publishedAt).toLocaleDateString('fr-FR') %></td>
              <td>
                <% if (rel.version === deployment.currentVersion) { %>
                  <span class="current-badge">✓ Déployée</span>
                <% } else { %>
                  <span style="color: #94a3b8;">Disponible</span>
                <% } %>
              </td>
              <td>
                <button type="button" class="btn-select" 
                  onclick="selectRelease('<%= rel.version %>', '<%= rel.downloadUrl %>', '<%= encodeURIComponent(rel.body) %>')">
                  Sélectionner
                </button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- API Integration Endpoint Info -->
    <div class="api-card">
      <strong style="color: #ffffff;">Intégration API de l'application macOS :</strong>
      <p style="color: #94a3b8; margin-top: 4px;">L'application native Overnode interroge ce point de terminaison à chaque lancement :</p>
      <div class="code-block">
        GET /api/v1/update/check?version=1.0.0&platform=darwin-arm64
      </div>
    </div>
  </main>

  <script>
    function selectRelease(version, url, encodedBody) {
      document.getElementById('version').value = version;
      document.getElementById('downloadUrl').value = url;
      try {
        document.getElementById('releaseNotes').value = decodeURIComponent(encodedBody);
      } catch (e) {
        document.getElementById('releaseNotes').value = encodedBody;
      }
      document.getElementById('deployForm').scrollIntoView({ behavior: 'smooth' });
    }
  </script>
</body>
</html>

