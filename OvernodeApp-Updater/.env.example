# OvernodeApp-Updater Environment Configuration
# Copy this file to .env and fill in the values

# REQUIRED: Session encryption secret (min 16 characters, use a random string)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: Override the auto-generated console registration code
# CONSOLE_CODE=UP-XXXX-XXXX

# Optional: GitHub token for private repository access
# GITHUB_TOKEN=ghp_xxxx

# Optional: GitHub repository (default: OvernodeProjets/OvernodeApp)
# GITHUB_REPO=OvernodeProjets/OvernodeApp

# Server port (default: 3344)
# PORT=3344

# Environment (set to 'production' to hide console code from logs)
# NODE_ENV=production
